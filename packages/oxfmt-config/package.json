{
    "name": "@goauthentik/oxfmt-config",
    "version": "9.1.0",
    "description": "authentik's Oxfmt config",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/goauthentik/authentik.git",
        "directory": "packages/oxfmt-config"
    },
    "files": [
        "out/**/*.js",
        "out/**/*.d.ts",
        "out/**/*.map",
        "src"
    ],
    "type": "module",
    "types": "./out/index.d.ts",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "import": "./out/index.js",
            "types": "./out/index.d.ts"
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsc -p .",
        "fix:oxfmt": "oxfmt --write .",
        "fix:oxlint": "oxlint --fix",
        "lint": "run-s lint:oxlint lint:oxfmt",
        "lint-check": "run-s lint-check:oxlint lint:oxfmt",
        "lint-check:oxlint": "oxlint --max-warnings=0",
        "lint:fix": "run-s fix:oxlint fix:oxfmt",
        "lint:oxfmt": "oxfmt --check .",
        "lint:oxlint": "oxlint",
        "prepare": "tsc -p ."
    },
    "devDependencies": {
        "@goauthentik/oxlint-config": "link:../oxlint-config",
        "@goauthentik/tsconfig": "link:../tsconfig",
        "npm-run-all": "^4.1.5",
        "oxfmt": "catalog:",
        "oxlint": "catalog:",
        "typescript": "catalog:"
    },
    "peerDependencies": {
        "oxfmt": ">=0.67.0 <1",
        "typescript": "^6.0.3 || ^7.0.0"
    },
    "engines": {
        "node": ">=24.0"
    }
}
