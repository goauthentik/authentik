{
    "name": "@goauthentik/docusaurus-config",
    "version": "3.4.0",
    "description": "authentik's Docusaurus config",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/goauthentik/authentik.git",
        "directory": "packages/docusaurus-config"
    },
    "files": [
        "./index.js",
        "lib/**/*",
        "css/**/*",
        "out/**/*"
    ],
    "type": "module",
    "types": "./out/index.d.ts",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./out/index.d.ts",
            "default": "./index.js"
        },
        "./css/*.css": "./css/*.css",
        "./plugins/brand": {
            "types": "./out/lib/plugins/brand.d.ts",
            "default": "./lib/plugins/brand.js"
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsc -p .",
        "fix": "run-s lint format",
        "check": "run-s lint:check format:check",
        "format": "oxfmt --write .",
        "format:check": "oxfmt --check .",
        "lint": "oxlint --fix",
        "lint:check": "oxlint --max-warnings=0"
    },
    "dependencies": {
        "@goauthentik/brand-assets": "^2.0.0",
        "deepmerge-ts": "^8.0.2",
        "prism-react-renderer": "^2.4.1"
    },
    "devDependencies": {
        "@docusaurus/theme-common": "^3.10.2",
        "@docusaurus/theme-search-algolia": "^3.10.2",
        "@docusaurus/types": "^3.10.2",
        "@goauthentik/fonts": "link:../fonts",
        "@goauthentik/oxfmt-config": "link:../oxfmt-config",
        "@goauthentik/oxlint-config": "link:../oxlint-config",
        "@goauthentik/tsconfig": "link:../tsconfig",
        "@types/node": "catalog:",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "npm-run-all": "^4.1.5",
        "oxfmt": "catalog:",
        "oxlint": "catalog:",
        "pino": "^10.3.1",
        "typescript": "catalog:"
    },
    "peerDependencies": {
        "@docusaurus/theme-common": "^3.10.1",
        "@docusaurus/theme-search-algolia": "^3.10.1",
        "@docusaurus/types": "^3.10.1",
        "@goauthentik/fonts": "^1.0.0 || ^2.0.0",
        "react": ">=19",
        "react-dom": ">=19"
    },
    "peerDependenciesMeta": {
        "@docusaurus/theme-search-algolia": {
            "optional": true
        },
        "react": {
            "optional": true
        },
        "react-dom": {
            "optional": true
        }
    },
    "optionalDependencies": {
        "react": "^19.3.1",
        "react-dom": "^19.3.1"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": "^24.22.3 || >=26.13.1",
            "onFail": "error"
        }
    },
    "engines": {
        "node": "^24.22.3 || >=26.13.1",
        "pnpm": ">=12.4.0"
    },
    "packageManager": "pnpm@12.23.0+sha512.02da94ffaf133f46074322afe552f90d40b5f71ae259aefbccdacc5085b1d617e98d65e0131f5748b9b67445978ee5055d7d59a473f1eef0d504854fefcd5975"
}
