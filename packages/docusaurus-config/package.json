{
    "name": "@goauthentik/docusaurus-config",
    "version": "3.0.4",
    "description": "authentik's Docusaurus config",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/goauthentik/authentik.git",
        "directory": "packages/docusaurus-config"
    },
    "files": [
        "./index.js",
        "lib/**/*",
        "css/**/*",
        "out/**/*"
    ],
    "type": "module",
    "types": "./out/index.d.ts",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./out/index.d.ts",
            "import": "./index.js"
        },
        "./css/*.css": "./css/*.css"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsc -p .",
        "fix": "run-s lint format",
        "check": "run-s lint:check format:check",
        "format": "oxfmt --write .",
        "format:check": "oxfmt --check .",
        "lint": "oxlint --fix",
        "lint:check": "oxlint --max-warnings=0"
    },
    "dependencies": {
        "deepmerge-ts": "^8.0.0",
        "prism-react-renderer": "^2.4.1"
    },
    "devDependencies": {
        "@docusaurus/theme-common": "^3.10.2",
        "@docusaurus/theme-search-algolia": "^3.10.2",
        "@docusaurus/types": "^3.10.2",
        "@goauthentik/oxfmt-config": "link:../oxfmt-config",
        "@goauthentik/oxlint-config": "link:../oxlint-config",
        "@goauthentik/tsconfig": "link:../tsconfig",
        "@types/node": "catalog:",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.7",
        "npm-run-all": "^4.1.5",
        "oxfmt": "catalog:",
        "oxlint": "catalog:",
        "pino": "^10.3.1",
        "typescript": "catalog:"
    },
    "peerDependencies": {
        "@docusaurus/theme-common": "^3.10.1",
        "@docusaurus/theme-search-algolia": "^3.10.1",
        "@docusaurus/types": "^3.10.1",
        "react": ">=19",
        "react-dom": ">=19"
    },
    "peerDependenciesMeta": {
        "@docusaurus/theme-search-algolia": {
            "optional": true
        },
        "react": {
            "optional": true
        },
        "react-dom": {
            "optional": true
        }
    },
    "optionalDependencies": {
        "react": "^19.2.8",
        "react-dom": "^19.2.8"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": ">=24.20",
            "onFail": "error"
        }
    },
    "engines": {
        "node": ">=24",
        "pnpm": ">=12.4.0"
    },
    "packageManager": "pnpm@12.4.0+sha512.37536c26ed40ab4134b6511e09f6b27f3ebb45687468f2406ca3805279a4e5ca158c1931350ad9774d6ab2108d71b3dbaeb39943159294375e4d053e8e05685c"
}
