{
    "name": "@goauthentik/esbuild-plugin-live-reload",
    "version": "3.1.0",
    "description": "ESBuild + browser refresh. Build completes, page reloads.",
    "keywords": [
        "authentik",
        "browser",
        "esbuild",
        "live-reload",
        "refresh",
        "reload"
    ],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/goauthentik/authentik.git",
        "directory": "packages/esbuild-plugin-live-reload"
    },
    "files": [
        "./index.js",
        "client/**/*",
        "plugin/**/*",
        "shared/**/*",
        "out/**/*"
    ],
    "type": "module",
    "main": "index.js",
    "types": "./out/index.d.ts",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./out/index.d.ts",
            "import": "./index.js"
        },
        "./shared": {
            "types": "./out/shared/index.d.ts",
            "import": "./shared/index.js"
        },
        "./client": {
            "types": "./out/client/index.d.ts",
            "import": "./client/index.js"
        },
        "./client/types": "./client/types.d.ts",
        "./plugin": {
            "types": "./out/plugin/index.d.ts",
            "import": "./plugin/index.js"
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "npm run build:types && npm run build:docs",
        "build:docs": "typedoc",
        "build:types": "tsc -p .",
        "fix": "run-s lint format",
        "check": "run-s lint:check format:check",
        "format": "oxfmt --write .",
        "format:check": "oxfmt --check .",
        "lint": "oxlint --fix",
        "lint:check": "oxlint --max-warnings=0"
    },
    "dependencies": {
        "find-free-ports": "^3.1.1"
    },
    "devDependencies": {
        "@goauthentik/logger-js": "link:../logger-js",
        "@goauthentik/oxfmt-config": "link:../oxfmt-config",
        "@goauthentik/oxlint-config": "link:../oxlint-config",
        "@goauthentik/tsconfig": "link:../tsconfig",
        "@types/node": "catalog:",
        "esbuild": "catalog:",
        "npm-run-all": "^4.1.5",
        "oxfmt": "catalog:",
        "oxlint": "catalog:",
        "typedoc": "^0.28.20",
        "typedoc-plugin-markdown": "^4.13.1",
        "typescript": "catalog:"
    },
    "peerDependencies": {
        "@goauthentik/logger-js": "^3.0.0",
        "esbuild": "^0.28.1"
    },
    "peerDependenciesMeta": {
        "@goauthentik/logger-js": {
            "optional": true
        }
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": "^24.22.3 || >=26.13.1",
            "onFail": "error"
        }
    },
    "engines": {
        "node": "^24.22.3 || >=26.13.1",
        "pnpm": ">=12.4.0"
    },
    "packageManager": "pnpm@12.22.0+sha512.894940a3d9a57dfa6fd373990fb4e41e09c2f2d76d982ed1d75275d39267f988fb4e2d40900cbe9921c68d97c67aa1a1096d276633db248f7b34927ac9ddb7a4"
}
