{
    "$schema": "https://json.schemastore.org/tsconfig",
    "compilerOptions": {
        "isolatedModules": true,
        "rootDir": "src",
        "strict": true,
        "newLine": "lf",
        "target": "ESNext",
        // The generator emits extensionless relative imports, which `NodeNext` rejects. Every
        // consumer links this package and bundles `src` directly, so resolve the way they do.
        "module": "preserve",
        "moduleResolution": "bundler",
        "outDir": "dist",
        "skipDefaultLibCheck": true,
        "skipLibCheck": true,
        "sourceMap": true,
        "declaration": true,
        "declarationMap": true,
        "lib": ["DOM", "DOM.Iterable", "ESNext"],
    },
    // Without this, `tsc` sweeps `**/*`, pulls in the tooling configs and `scripts/`, and emits
    // their JS next to the source because they fall outside `rootDir`.
    "include": ["src"],
    "exclude": ["node_modules", "./out/**/*", "./dist/**/*"],
}
