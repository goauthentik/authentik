{
    "name": "@goauthentik/api",
    "version": "0.0.0",
    "description": "OpenAPI client for @goauthentik/api",
    "author": "OpenAPI-Generator",
    "repository": {
        "type": "git",
        "url": "https://github.com/goauthentik/authentik.git"
    },
    "type": "module",
    "sideEffects": false,
    "main": "./src/index.ts",
    "module": "./src/index.ts",
    "types": "./src/index.ts",
    "scripts": {
        "build": "pnpm run clean && tsc -b tsconfig.json",
        "check": "run-s lint:check format:check",
        "clean": "tsc -b --clean tsconfig.json",
        "fix": "run-s lint format",
        "format": "oxfmt --write .",
        "format:check": "oxfmt --check .",
        "lint": "oxlint --fix --quiet && oxlint --fix --quiet",
        "lint:check": "oxlint --max-warnings=0",
        "post-process": "node ./scripts/post-process.ts",
        "prepare": "pnpm run build"
    },
    "devDependencies": {
        "@goauthentik/oxfmt-config": "link:../oxfmt-config",
        "@goauthentik/oxlint-config": "link:../oxlint-config",
        "@goauthentik/tsconfig": "link:../tsconfig",
        "@types/node": "catalog:",
        "npm-run-all": "^4.1.5",
        "oxfmt": "catalog:",
        "oxlint": "catalog:",
        "typescript": "catalog:"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": ">=24.20",
            "onFail": "error"
        }
    },
    "engines": {
        "node": ">=24",
        "pnpm": ">=12.4.0"
    },
    "packageManager": "pnpm@12.9.1+sha512.06b055fff5cd20dc12781de173ced3310ce0951bf2ec620211a16045d5444d5c93a663210764ef29a653a610459ba0368f0e74f84d80c54723cf95aae7bc0d6d"
}
