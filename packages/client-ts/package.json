{
    "name": "@goauthentik/api",
    "version": "0.0.0",
    "description": "OpenAPI client for @goauthentik/api",
    "author": "OpenAPI-Generator",
    "repository": {
        "type": "git",
        "url": "https://github.com/goauthentik/authentik.git"
    },
    "type": "module",
    "sideEffects": false,
    "main": "./src/index.ts",
    "module": "./src/index.ts",
    "types": "./src/index.ts",
    "scripts": {
        "build": "pnpm run clean && tsc -b tsconfig.json tsconfig.esm.json",
        "clean": "tsc -b --clean tsconfig.json tsconfig.esm.json",
        "fix:oxfmt": "oxfmt --write .",
        "fix:oxlint": "oxlint --fix",
        "lint": "run-s lint:oxlint lint:oxfmt",
        "lint:fix": "run-s fix:oxlint fix:oxfmt",
        "lint:oxfmt": "oxfmt --check .",
        "lint:oxlint": "oxlint",
        "lint-check": "run-s lint-check:oxlint lint:oxfmt",
        "lint-check:oxlint": "oxlint --max-warnings=0",
        "prepare": "pnpm run build"
    },
    "devDependencies": {
        "@goauthentik/oxfmt-config": "link:../oxfmt-config",
        "@goauthentik/oxlint-config": "link:../oxlint-config",
        "oxfmt": "catalog:",
        "oxlint": "catalog:",
        "typescript": "catalog:"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": ">=24.20",
            "onFail": "error"
        }
    },
    "engines": {
        "node": ">=24",
        "pnpm": ">=12.4.0"
    },
    "packageManager": "pnpm@12.4.0+sha512.37536c26ed40ab4134b6511e09f6b27f3ebb45687468f2406ca3805279a4e5ca158c1931350ad9774d6ab2108d71b3dbaeb39943159294375e4d053e8e05685c"
}
