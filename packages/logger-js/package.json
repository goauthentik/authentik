{
    "name": "@goauthentik/logger-js",
    "version": "3.0.0",
    "description": "Pino-based logger for authentik",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/goauthentik/authentik.git",
        "directory": "packages/logger-js"
    },
    "scripts": {
        "build": "tsc -p .",
        "lint": "run-s lint:oxlint",
        "lint:oxlint": "oxlint",
        "lint:oxfmt": "oxfmt --check .",
        "lint:fix": "run-s fix:oxlint fix:oxfmt",
        "fix:oxlint": "oxlint --fix",
        "fix:oxfmt": "oxfmt --write .",
        "lint-check": "run-s lint-check:oxlint",
        "lint-check:oxlint": "oxlint --max-warnings=0",
        "watch": "tsc -p . --watch"
    },
    "type": "module",
    "types": "./out/index.d.ts",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "node": {
                "types": "./out/lib/node.d.ts",
                "default": "./lib/node.ts"
            },
            "browser": {
                "types": "./out/index.d.ts",
                "default": "./out/index.js"
            },
            "default": {
                "types": "./out/index.d.ts",
                "default": "./out/index.js"
            }
        }
    },
    "devDependencies": {
        "@goauthentik/oxlint-config": "link:../oxlint-config",
        "@goauthentik/oxfmt-config": "link:../oxfmt-config",
        "oxlint": "catalog:",
        "oxfmt": "catalog:",
        "@goauthentik/tsconfig": "link:../tsconfig",
        "@types/node": "catalog:",
        "pino": "^10.3.1",
        "pino-pretty": "^13.1.3",
        "typescript": "catalog:"
    },
    "peerDependencies": {
        "pino": "^10.3.1",
        "pino-pretty": "^13.1.2"
    },
    "files": [
        "out/**/*",
        "types/**/*"
    ],
    "engines": {
        "node": ">=24",
        "pnpm": ">=12.4.0"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": ">=24.20",
            "onFail": "error"
        }
    },
    "packageManager": "pnpm@12.4.0+sha512.37536c26ed40ab4134b6511e09f6b27f3ebb45687468f2406ca3805279a4e5ca158c1931350ad9774d6ab2108d71b3dbaeb39943159294375e4d053e8e05685c",
    "peerDependenciesMeta": {
        "pino": {
            "optional": true
        },
        "pino-pretty": {
            "optional": true
        }
    },
    "publishConfig": {
        "access": "public",
        "exports": {
            "./package.json": "./package.json",
            ".": {
                "node": {
                    "types": "./out/lib/node.d.ts",
                    "default": "./out/lib/node.js"
                },
                "browser": {
                    "types": "./out/index.d.ts",
                    "default": "./out/index.js"
                },
                "default": {
                    "types": "./out/index.d.ts",
                    "default": "./out/index.js"
                }
            }
        }
    }
}
