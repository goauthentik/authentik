{
    "name": "@goauthentik/logger-js",
    "version": "3.0.0",
    "description": "Pino-based logger for authentik",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/goauthentik/authentik.git",
        "directory": "packages/logger-js"
    },
    "scripts": {
        "build": "tsc -p .",
        "lint": "eslint --fix .",
        "lint-check": "eslint --max-warnings 0 .",
        "prettier": "prettier --write .",
        "prettier-check": "prettier --check .",
        "watch": "tsc -p . --watch"
    },
    "type": "module",
    "types": "./out/index.d.ts",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "node": {
                "types": "./out/lib/node.d.ts",
                "default": "./lib/node.ts"
            },
            "browser": {
                "types": "./out/index.d.ts",
                "default": "./out/index.js"
            },
            "default": {
                "types": "./out/index.d.ts",
                "default": "./out/index.js"
            }
        }
    },
    "devDependencies": {
        "@eslint/js": "catalog:",
        "@goauthentik/prettier-config": "link:../prettier-config",
        "@goauthentik/tsconfig": "link:../tsconfig",
        "@types/node": "catalog:",
        "eslint": "catalog:",
        "pino": "^10.3.1",
        "pino-pretty": "^13.1.3",
        "prettier": "catalog:",
        "prettier-plugin-packagejson": "catalog:",
        "typescript": "catalog:",
        "typescript-eslint": "^8.65.0"
    },
    "peerDependencies": {
        "pino": "^10.3.1",
        "pino-pretty": "^13.1.2"
    },
    "files": [
        "out/**/*",
        "types/**/*"
    ],
    "engines": {
        "node": ">=24"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": ">=24",
            "onFail": "ignore"
        },
        "packageManager": {
            "name": "pnpm",
            "version": ">=11.5.1",
            "onFail": "ignore"
        }
    },
    "prettier": "@goauthentik/prettier-config",
    "peerDependenciesMeta": {
        "pino": {
            "optional": true
        },
        "pino-pretty": {
            "optional": true
        }
    },
    "publishConfig": {
        "access": "public",
        "exports": {
            "./package.json": "./package.json",
            ".": {
                "node": {
                    "types": "./out/lib/node.d.ts",
                    "default": "./out/lib/node.js"
                },
                "browser": {
                    "types": "./out/index.d.ts",
                    "default": "./out/index.js"
                },
                "default": {
                    "types": "./out/index.d.ts",
                    "default": "./out/index.js"
                }
            }
        }
    }
}
