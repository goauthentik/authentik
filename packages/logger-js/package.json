{
    "name": "@goauthentik/logger-js",
    "version": "3.0.0",
    "description": "Pino-based logger for authentik",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/goauthentik/authentik.git",
        "directory": "packages/logger-js"
    },
    "files": [
        "out/**/*",
        "types/**/*"
    ],
    "type": "module",
    "types": "./out/index.d.ts",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "node": {
                "types": "./out/lib/node.d.ts",
                "default": "./lib/node.ts"
            },
            "browser": {
                "types": "./out/index.d.ts",
                "default": "./out/index.js"
            },
            "default": {
                "types": "./out/index.d.ts",
                "default": "./out/index.js"
            }
        }
    },
    "publishConfig": {
        "exports": {
            "./package.json": "./package.json",
            ".": {
                "node": {
                    "types": "./out/lib/node.d.ts",
                    "default": "./out/lib/node.js"
                },
                "browser": {
                    "types": "./out/index.d.ts",
                    "default": "./out/index.js"
                },
                "default": {
                    "types": "./out/index.d.ts",
                    "default": "./out/index.js"
                }
            }
        },
        "access": "public"
    },
    "scripts": {
        "build": "tsc -p .",
        "fix": "run-s lint format",
        "check": "run-s lint:check format:check",
        "format": "oxfmt --write .",
        "format:check": "oxfmt --check .",
        "lint": "oxlint --fix",
        "lint:check": "oxlint --max-warnings=0",
        "watch": "tsc -p . --watch"
    },
    "devDependencies": {
        "@goauthentik/oxfmt-config": "link:../oxfmt-config",
        "@goauthentik/oxlint-config": "link:../oxlint-config",
        "@goauthentik/tsconfig": "link:../tsconfig",
        "@types/node": "catalog:",
        "npm-run-all": "^4.1.5",
        "oxfmt": "catalog:",
        "oxlint": "catalog:",
        "pino": "^10.3.1",
        "pino-pretty": "^13.1.3",
        "typescript": "catalog:"
    },
    "peerDependencies": {
        "pino": "^10.3.1",
        "pino-pretty": "^13.1.2"
    },
    "peerDependenciesMeta": {
        "pino": {
            "optional": true
        },
        "pino-pretty": {
            "optional": true
        }
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": ">=24.20",
            "onFail": "error"
        }
    },
    "engines": {
        "node": ">=24",
        "pnpm": ">=12.4.0"
    },
    "packageManager": "pnpm@12.9.1+sha512.06b055fff5cd20dc12781de173ced3310ce0951bf2ec620211a16045d5444d5c93a663210764ef29a653a610459ba0368f0e74f84d80c54723cf95aae7bc0d6d"
}
