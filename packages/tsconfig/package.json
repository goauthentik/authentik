{
    "name": "@goauthentik/tsconfig",
    "version": "3.0.0",
    "description": "authentik's base TypeScript configuration.",
    "keywords": [
        "tsconfig",
        "typescript"
    ],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/goauthentik/authentik.git",
        "directory": "packages/tsconfig"
    },
    "files": [
        "tsconfig.json",
        "tsconfig.node.json",
        "tsconfig.web.json"
    ],
    "type": "module",
    "main": "tsconfig.json",
    "exports": {
        "./package.json": "./package.json",
        ".": "./tsconfig.json",
        "./node": "./tsconfig.node.json",
        "./web": "./tsconfig.web.json"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "exit 0"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": ">=24.20",
            "onFail": "warn"
        }
    },
    "engines": {
        "node": ">=24"
    }
}
