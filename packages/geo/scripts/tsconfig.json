{
    "extends": "@goauthentik/tsconfig",
    "compilerOptions": {
        "allowImportingTsExtensions": true,
        "noEmit": true,
        "erasableSyntaxOnly": true,
        "emitDeclarationOnly": false,
        "declaration": false,
        "declarationMap": false,
        "sourceMap": false,
        "composite": false,
        "incremental": false,
        "checkJs": false,
        "allowJs": false,
        // The generator imports the runtime modules (bands, labels, style), so
        // its program pulls in browser code that reaches for `window`.
        "lib": ["ESNext", "DOM", "DOM.Iterable"],
        // The generator reads the archive contract (bands, labels,
        // attribution) from web, so the program spans both packages.
        "rootDir": "../../.."
    },
    "include": ["./**/*.ts"],
    "exclude": ["./**/out/**", "./**/node_modules/**"]
}
