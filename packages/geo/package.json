{
    "name": "@goauthentik/geo",
    "version": "1.0.1",
    "private": true,
    "description": "Geo data generators for authentik: the hexworld basemap and the ASN database",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/goauthentik/authentik.git",
        "directory": "packages/geo"
    },
    "type": "module",
    "scripts": {
        "asn:build": "node scripts/build-asn.ts",
        "build:types": "tsc -p . --noEmit && tsc -p scripts && tsc -p test",
        "hexworld:build": "node scripts/build-hexworld.ts",
        "fix": "run-s lint format",
        "check": "run-s lint:check build:types format:check",
        "format": "oxfmt --write .",
        "format:check": "oxfmt --check .",
        "lint": "oxlint --fix",
        "lint:check": "oxlint --max-warnings=0",
        "test": "vitest run",
        "test:watch": "vitest",
        "tiles:pull-hexworld": "node scripts/pull-hexworld.ts"
    },
    "dependencies": {
        "h3-js": "^4.5.0",
        "ipaddr.js": "^2.4.0",
        "pmtiles": "^4.4.1"
    },
    "devDependencies": {
        "@goauthentik/oxfmt-config": "link:../oxfmt-config",
        "@goauthentik/oxlint-config": "link:../oxlint-config",
        "@goauthentik/tsconfig": "link:../tsconfig",
        "@mapbox/vector-tile": "^3.0.0",
        "@types/geojson": "^7946.0.16",
        "@types/node": "catalog:",
        "mmdb-lib": "^3.0.3",
        "npm-run-all": "^4.1.5",
        "oxfmt": "catalog:",
        "oxlint": "catalog:",
        "pbf": "^5.1.2",
        "typescript": "catalog:",
        "vite": "catalog:",
        "vitest": "catalog:"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": "^24.22.1 || >=26.12.1",
            "onFail": "warn"
        }
    },
    "engines": {
        "node": "^24.22.1 || >=26.12.1"
    }
}
