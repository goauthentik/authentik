{
    "name": "@goauthentik/theme",
    "version": "2.2.0",
    "description": "Styleframe-based design system for authentik.",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/goauthentik/authentik.git",
        "directory": "packages/theme"
    },
    "files": [
        "src/**/*",
        "dist/**/*"
    ],
    "type": "module",
    "types": "./src/index.ts",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "node": "./src/index.ts",
            "bundler": "./src/index.ts",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json",
        "./types": "./src/index.ts",
        "./node": {
            "types": "./src/node.ts",
            "node": "./src/node.ts",
            "bundler": "./src/node.ts",
            "default": "./dist/node.js"
        },
        "./browser": {
            "types": "./src/index.ts",
            "node": "./src/index.ts",
            "bundler": "./src/index.ts",
            "default": "./dist/index.js"
        },
        "./index.css": "./dist/index.css",
        "./tokens.dtcg.json": "./dist/dtcg/tokens.json",
        "./tokens.dtcg.resolver.json": "./dist/dtcg/tokens.resolver.json",
        "./tokens": {
            "types": "./src/index.ts",
            "node": "./src/index.ts",
            "bundler": "./src/index.ts",
            "default": "./dist/index.js"
        },
        "./build": {
            "types": "./src/node.ts",
            "node": "./src/node.ts",
            "bundler": "./src/node.ts",
            "default": "./dist/node.js"
        }
    },
    "publishConfig": {
        "types": "./dist/index.d.ts",
        "exports": {
            ".": {
                "types": "./dist/index.d.ts",
                "import": "./dist/index.js"
            },
            "./package.json": "./package.json",
            "./types": "./dist/index.d.ts",
            "./node": {
                "types": "./dist/node.d.ts",
                "import": "./dist/node.js"
            },
            "./browser": {
                "types": "./dist/index.d.ts",
                "import": "./dist/index.js"
            },
            "./index.css": "./dist/index.css",
            "./tokens.dtcg.json": "./dist/dtcg/tokens.json",
            "./tokens.dtcg.resolver.json": "./dist/dtcg/tokens.resolver.json",
            "./tokens": {
                "types": "./dist/index.d.ts",
                "import": "./dist/index.js"
            },
            "./build": {
                "types": "./dist/node.d.ts",
                "import": "./dist/node.js"
            }
        },
        "access": "public"
    },
    "scripts": {
        "build": "wireit",
        "build:assets": "node ./build.ts",
        "build:demo": "node ./build-demo.ts",
        "build:dtcg": "styleframe dtcg export --config styleframe.config.ts --output dist/dtcg --collection authentik",
        "build:src": "tsgo -p .",
        "check": "run-s lint:check format:check lint-output",
        "clean": "rimraf ./public",
        "demo": "run-s build build:demo demo:run",
        "demo:run": "http-server ./public -p 8001 -i",
        "fix": "run-s lint format",
        "format": "oxfmt --write .",
        "format:check": "oxfmt --check .",
        "lint": "oxlint --fix",
        "lint-output": "run-s build:src build:assets lint:css lint:bridge",
        "lint:bridge": "node lint-bridge.ts",
        "lint:check": "oxlint --max-warnings=0",
        "lint:css": "stylelint \"dist/*.css\"",
        "watch": "tsgo -p . --watch"
    },
    "wireit": {
        "build": {
            "command": "run-s build:src build:assets build:dtcg",
            "files": [
                "src/**/*.ts",
                "build.ts",
                "styleframe.config.ts",
                "tsconfig.json",
                "package.json"
            ],
            "output": [
                "dist/**"
            ]
        }
    },
    "dependencies": {
        "@styleframe/core": "3.6.2",
        "@styleframe/dtcg": "^1.1.0",
        "@styleframe/theme": "3.10.0",
        "@styleframe/transpiler": "3.4.2",
        "rimraf": "^6.1.4",
        "styleframe": "3.9.1"
    },
    "devDependencies": {
        "@goauthentik/fonts": "link:../fonts",
        "@goauthentik/oxfmt-config": "link:../oxfmt-config",
        "@goauthentik/oxlint-config": "link:../oxlint-config",
        "@goauthentik/tsconfig": "link:../tsconfig",
        "@styleframe/cli": "4.1.2",
        "@types/culori": "^4.0.1",
        "@types/node": "catalog:",
        "@typescript/native-preview": "7.0.0-dev.20260707.2",
        "culori": "^4.0.2",
        "http-server": "^14.1.1",
        "npm-run-all": "^4.1.5",
        "oxfmt": "catalog:",
        "oxlint": "catalog:",
        "stylelint": "^18.1.0",
        "stylelint-config-recommended": "^19.1.0",
        "typescript": "catalog:",
        "wireit": "^0.15.0"
    },
    "peerDependencies": {
        "@goauthentik/fonts": "^1.0.0 || ^2.0.0"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": "^24.22.3 || >=26.13.1",
            "onFail": "error"
        }
    },
    "engines": {
        "node": "^24.22.3 || >=26.13.1",
        "pnpm": ">=12.4.0"
    },
    "packageManager": "pnpm@12.23.0+sha512.02da94ffaf133f46074322afe552f90d40b5f71ae259aefbccdacc5085b1d617e98d65e0131f5748b9b67445978ee5055d7d59a473f1eef0d504854fefcd5975",
    "#exports-comment": [
        "The TypeScript entry points resolve to src/ for tooling that can read",
        "TypeScript directly — tsc via `types`, node via jiti/tsgo, and bundlers",
        "that opt into the `bundler` condition (see web/scripts/build-web.ts).",
        "`default` keeps the built dist/ output for plain Node and any consumer",
        "that does not set a condition; publishConfig.exports points every entry",
        "at dist/ for the published tarball.",
        "The CSS and DTCG entries have no source form — they are generated by",
        "build.ts and the styleframe CLI — so they always resolve to dist/."
    ]
}
