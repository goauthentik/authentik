{
    "name": "@goauthentik/docs",
    "version": "0.0.0",
    "private": true,
    "license": "MIT",
    "scripts": {
        "build": "pnpm --filter \"./docs\" run build",
        "build:api": "pnpm --filter \"./api\" run build",
        "build:integrations": "pnpm --filter \"./integrations\" run build",
        "build:types": "tsc -b",
        "docusaurus": "docusaurus",
        "fix": "run-s lint build:types format",
        "check": "run-s lint:check build:types format:check",
        "format": "oxfmt --write .",
        "format:check": "oxfmt --check .",
        "lint": "oxlint --fix",
        "lint:check": "oxlint --max-warnings=0",
        "start": "pnpm --filter \"./docs\" run start",
        "test": "node --test"
    },
    "dependencies": {
        "@goauthentik/brand-assets": "^2.0.0",
        "@goauthentik/docusaurus-theme": "workspace:*",
        "@goauthentik/oxfmt-config": "link:../packages/oxfmt-config",
        "@goauthentik/oxlint-config": "link:../packages/oxlint-config",
        "@goauthentik/tsconfig": "link:../packages/tsconfig",
        "@types/node": "catalog:",
        "deepmerge-ts": "^7.1.5",
        "escape-string-regexp": "^5.0.0",
        "netlify-plugin-cache": "^1.0.3",
        "netlify-redirect-parser": "^14.4.0",
        "npm-run-all": "^4.1.5",
        "oxfmt": "catalog:",
        "oxlint": "catalog:",
        "postman-code-generators": "2.1.1",
        "typescript": "catalog:"
    },
    "optionalDependencies": {
        "@rspack/binding-darwin-arm64": "2.2.4",
        "@rspack/binding-linux-arm64-gnu": "2.2.4",
        "@rspack/binding-linux-x64-gnu": "2.2.4",
        "@swc/core-darwin-arm64": "1.16.2",
        "@swc/core-linux-arm64-gnu": "1.16.2",
        "@swc/core-linux-x64-gnu": "1.16.2",
        "@swc/html-darwin-arm64": "1.16.2",
        "@swc/html-linux-arm64-gnu": "1.16.2",
        "@swc/html-linux-x64-gnu": "1.16.2",
        "lightningcss-darwin-arm64": "1.33.0",
        "lightningcss-linux-arm64-gnu": "1.33.0",
        "lightningcss-linux-x64-gnu": "1.33.0"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": ">=24.20",
            "onFail": "error"
        }
    },
    "engines": {
        "node": ">=24",
        "pnpm": ">=12.4.0"
    },
    "packageManager": "pnpm@12.4.0+sha512.37536c26ed40ab4134b6511e09f6b27f3ebb45687468f2406ca3805279a4e5ca158c1931350ad9774d6ab2108d71b3dbaeb39943159294375e4d053e8e05685c"
}
