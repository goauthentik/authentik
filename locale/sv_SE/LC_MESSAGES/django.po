#: authentik/admin/files/api.py
#, python-brace-format
msgid "File size ({file.size}B) exceeds maximum allowed "
msgstr "Filstorleken ({file.size} B) överskrider högsta tillåtna storlek "

#: authentik/admin/files/validation.py
msgid "File name cannot be empty"
msgstr "Filnamnet får inte vara tomt"

#: authentik/admin/files/validation.py
#, python-format
msgid ""
"File name can only contain letters (a-z, A-Z), numbers (0-9), dots (.), "
"hyphens (-), underscores (_), forward slashes (/), and the placeholder "
"%(theme)s for theme-specific files"
msgstr ""
"Filnamnet får endast innehålla bokstäver (a-z, A-Z), siffror (0-9), punkter "
"(.), bindestreck (-), understreck (_), snedstreck (/) och platshållaren "
"%(theme)s för temaspecifika filer"

#: authentik/admin/files/validation.py
msgid "File name cannot contain duplicate /"
msgstr "Filnamnet får inte innehålla dubbla /"

#: authentik/admin/files/validation.py
msgid "Absolute paths are not allowed"
msgstr "Absoluta sökvägar är inte tillåtna"

#: authentik/admin/files/validation.py
msgid "Parent directory references ('..') are not allowed"
msgstr "Referenser till överordnad katalog (”..”) är inte tillåtna"

#: authentik/admin/files/validation.py
msgid "Paths cannot start with '.'"
msgstr "Sökvägar får inte börja med ”.”"

#: authentik/admin/files/validation.py
#, python-brace-format
msgid "File name too long (max {MAX_FILE_NAME_LENGTH} characters)"
msgstr "Filnamnet är för långt (högst {MAX_FILE_NAME_LENGTH} tecken)"

#: authentik/admin/files/validation.py
#, python-brace-format
msgid "Path component too long (max {MAX_PATH_COMPONENT_LENGTH} characters)"
msgstr ""
"Sökvägskomponenten är för lång (högst {MAX_PATH_COMPONENT_LENGTH} tecken)"

