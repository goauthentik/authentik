#: authentik/common/oauth/constants.py
msgid "Based on the Hashed User ID"
msgstr "Baseret på det hashede bruger-ID"

#: authentik/common/oauth/constants.py
msgid "Based on user ID"
msgstr "Baseret på bruger-ID"

#: authentik/common/oauth/constants.py
msgid "Based on user UUID"
