#, python-brace-format
msgid "authentik Export - {date}"
msgstr "authentik-eksport – {date}"

#: authentik/blueprints/v1/tasks.py
msgid "Find blueprints as `blueprints_find` does, but return a safe dict."
msgstr ""
"Find blueprints som `blueprints_find` gør, men returnér en sikker dict."

#: authentik/blueprints/v1/tasks.py
msgid "Find blueprints and check if they need to be created in the database."
msgstr "Find blueprints, og kontrollér om de skal oprettes i databasen."

#: authentik/blueprints/v1/tasks.py
msgid "Apply single blueprint."
msgstr "Anvend et enkelt blueprint."

#: authentik/blueprints/v1/tasks.py
msgid "Remove blueprints which couldn't be fetched."
msgstr "Fjern blueprints, der ikke kunne hentes."

#: authentik/brands/models.py
msgid ""
"Domain that activates this brand. Can be a superset, i.e. `a.b` for `aa.b` "
"and `ba.b`"
msgstr ""
"Domæne der aktiverer dette brand. Kan være en overmængde, altså `a.b` for "
"`aa.b` og `ba.b`"

#: authentik/brands/models.py
#, python-brace-format
msgid ""
"URL template for the vector tile source used by the events map. Supports XYZ"
" templates with {z}, {x} and {y} placeholders, or pmtiles:// archive URLs. "
"When empty, the frontend uses the bundled hexworld basemap. This value is "
"part of the brand information served to unauthenticated clients; do not "
"embed API keys or other credentials in it."
msgstr ""
"URL-skabelon til den vektorfliskilde, som hændelseskortet bruger. "
"Understøtter XYZ-skabeloner med pladsholderne {z}, {x} og {y} eller arkiv-"
"URL'er med pmtiles://. Når feltet er tomt, bruger frontenden det medfølgende"
" hexworld-basiskort. Denne værdi er en del af de brand-oplysninger, der "
"leveres til ikke-godkendte klienter; indlejr ikke API-nøgler eller andre "
"legitimationsoplysninger i den."

#: authentik/brands/models.py
msgid ""
"When set, external users will be redirected to this application after "
"authenticating."
msgstr ""
"Når dette er angivet, omdirigeres eksterne brugere til denne applikation "
"efter godkendelse."

#: authentik/brands/models.py
