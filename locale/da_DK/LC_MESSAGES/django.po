#: authentik/tenants/api/settings.py
#, python-brace-format
msgid "Value for flag {flag_key} needs to be of type {type}."
msgstr "Værdien for flaget {flag_key} skal være af typen {type}."

#: authentik/tenants/models.py
msgid ""
"Schema name must start with t_, only contain lowercase letters and numbers "
"and be less than 63 characters."
msgstr ""
"Skemanavnet skal begynde med t_, må kun indeholde små bogstaver og tal og "
"skal være under 63 tegn."

#: authentik/tenants/models.py
msgid "Configure how authentik should show avatars for users."
msgstr "Konfigurér hvordan authentik skal vise avatarer for brugere."

#: authentik/tenants/models.py
msgid "Enter a valid URL, for example https://authentik.company"
msgstr "Indtast en gyldig URL, for eksempel https://authentik.company"

#: authentik/tenants/models.py
msgid ""
"Configure the base URL under which this authentik instance is reachable, "
"e.g. https://authentik.company"
msgstr ""
"Konfigurér den basis-URL som denne authentik-instans kan nås på, f.eks. "
"https://authentik.company"

#: authentik/tenants/models.py
msgid "Enable the ability for users to change their name."
msgstr "Giv brugere mulighed for at ændre deres navn."

#: authentik/tenants/models.py
msgid "Enable the ability for users to change their email address."
msgstr "Giv brugere mulighed for at ændre deres e-mailadresse."

#: authentik/tenants/models.py
msgid "Enable the ability for users to change their username."
msgstr "Giv brugere mulighed for at ændre deres brugernavn."

#: authentik/tenants/models.py
msgid ""
"Events will be deleted after this duration.(Format: "
"weeks=3;days=2;hours=3,seconds=2)."
msgstr ""
"Hændelser slettes efter denne varighed. (Format: "
"weeks=3;days=2;hours=3,seconds=2)."

#: authentik/tenants/models.py
msgid "Reputation cannot decrease lower than this value. Zero or negative."
msgstr "Omdømmet kan ikke falde under denne værdi. Nul eller negativ."

#: authentik/tenants/models.py
msgid "Reputation cannot increase higher than this value. Zero or positive."
msgstr "Omdømmet kan ikke stige over denne værdi. Nul eller positiv."

#: authentik/tenants/models.py
msgid "The option configures the footer links on the flow executor pages."
msgstr "Indstillingen konfigurerer sidefodslinkene på flow-eksekverens sider."

#: authentik/tenants/models.py
msgid ""
"When enabled, all the events caused by a user will be deleted upon the "
"user's deletion."
msgstr ""
"Når dette er aktiveret, slettes alle hændelser forårsaget af en bruger, når "
"brugeren slettes."

#: authentik/tenants/models.py
msgid "Globally enable/disable impersonation."
msgstr "Aktivér/deaktivér repræsentation globalt."

#: authentik/tenants/models.py
msgid "Require administrators to provide a reason for impersonating a user."
msgstr ""
"Kræv at administratorer angiver en begrundelse for at repræsentere en "
"bruger."

#: authentik/tenants/models.py
msgid "Default token duration"
msgstr "Standardvarighed for token"

#: authentik/tenants/models.py
msgid "Default token length"
msgstr "Standardlængde for token"

#: authentik/tenants/models.py
msgid "Default page size for API responses, if no size was requested."
