#: authentik/admin/api/settings.py
#, python-brace-format
msgid "Value for flag {flag_key} needs to be of type {type}."
msgstr "Значення прапорця {flag_key} має бути типу {type}."

#: authentik/admin/files/api.py
#, python-brace-format
msgid "File size ({size}B) exceeds maximum allowed size ({max_size}B)."
msgstr ""
"Розмір файлу ({size}B) перевищує максимально дозволений розмір "
"({max_size}B)."

#: authentik/admin/files/validation.py
msgid "File name cannot be empty"
msgstr "Ім'я файлу не може бути порожнім"

#: authentik/admin/files/validation.py
#, python-format
msgid ""
"File name can only contain letters (a-z, A-Z), numbers (0-9), dots (.), "
"hyphens (-), underscores (_), forward slashes (/), and the placeholder "
"%(theme)s for theme-specific files"
msgstr ""
"Ім'я файлу може містити лише літери (a-z, A-Z), цифри (0-9), крапки (.), "
"дефіси (-), підкреслення (_), прямі слеші (/) та шаблон %(theme)s для "
"файлів, специфічних для теми"

#: authentik/admin/files/validation.py
msgid "File name cannot contain duplicate /"
msgstr "Ім'я файлу не може містити повторювані /"

#: authentik/admin/files/validation.py
msgid "Absolute paths are not allowed"
msgstr "Абсолютні шляхи не дозволені"

#: authentik/admin/files/validation.py
msgid "Parent directory references ('..') are not allowed"
msgstr "Посилання на батьківський каталог ('..') не дозволені"

#: authentik/admin/files/validation.py
msgid "Paths cannot start with '.'"
msgstr "Шляхи не можуть починатися з '.'"

#: authentik/admin/files/validation.py
#, python-brace-format
msgid "File name too long (max {MAX_FILE_NAME_LENGTH} characters)"
msgstr "Ім'я файлу занадто довге (максимум {MAX_FILE_NAME_LENGTH} символів)"

#: authentik/admin/files/validation.py
#, python-brace-format
msgid "Path component too long (max {MAX_PATH_COMPONENT_LENGTH} characters)"
msgstr ""
"Компонент шляху занадто довгий (максимум {MAX_PATH_COMPONENT_LENGTH} "
"символів)"

#: authentik/admin/models.py
msgid "Configure how authentik should show avatars for users."
msgstr "Налаштуйте, як authentik має показувати аватари користувачів."

#: authentik/admin/models.py
msgid "Enter a valid URL, for example https://authentik.company"
msgstr "Введіть дійсний URL, наприклад https://authentik.company"

#: authentik/admin/models.py
msgid ""
"Configure the base URL under which this authentik instance is reachable, "
"e.g. https://authentik.company"
msgstr ""
"Налаштуйте базову URL-адресу, за якою доступний цей екземпляр authentik, "
"наприклад https://authentik.company"

#: authentik/admin/models.py
msgid "Enable the ability for users to change their name."
msgstr "Дозволити користувачам змінювати своє ім'я."

#: authentik/admin/models.py
msgid "Enable the ability for users to change their email address."
msgstr "Дозволити користувачам змінювати свою адресу електронної пошти."

#: authentik/admin/models.py
msgid "Enable the ability for users to change their username."
msgstr "Дозволити користувачам змінювати своє ім'я користувача."

#: authentik/admin/models.py
msgid ""
"Events will be deleted after this duration.(Format: "
"weeks=3;days=2;hours=3,seconds=2)."
msgstr ""
"Події буде видалено після цієї тривалості. (Формат: "
"weeks=3;days=2;hours=3,seconds=2)."

#: authentik/admin/models.py
msgid "Reputation cannot decrease lower than this value. Zero or negative."
msgstr ""
"Репутація не може знижуватися нижче цього значення. Нуль або від'ємне."

#: authentik/admin/models.py
msgid "Reputation cannot increase higher than this value. Zero or positive."
msgstr ""
"Репутація не може підвищуватися вище цього значення. Нуль або додатне."

#: authentik/admin/models.py
msgid "The option configures the footer links on the flow executor pages."
msgstr ""
"Цей параметр налаштовує посилання в нижньому колонтитулі на сторінках "
"виконавця потоків."

#: authentik/admin/models.py
msgid ""
"When enabled, all the events caused by a user will be deleted upon the "
"user's deletion."
msgstr ""
"Коли ввімкнено, усі події, спричинені користувачем, видалятимуться під час "
"видалення користувача."

#: authentik/admin/models.py
msgid "Globally enable/disable impersonation."
msgstr "Глобально ввімкнути/вимкнути видавання себе за іншого користувача."

#: authentik/admin/models.py
msgid "Require administrators to provide a reason for impersonating a user."
msgstr ""
"Вимагати від адміністраторів зазначати причину видавання себе за "
"користувача."

#: authentik/admin/models.py
msgid "Default token duration"
msgstr "Тривалість токена за замовчуванням"

#: authentik/admin/models.py
msgid "Default token length"
msgstr "Довжина токена за замовчуванням"

#: authentik/admin/models.py
msgid "Default page size for API responses, if no size was requested."
msgstr ""
"Розмір сторінки за замовчуванням для відповідей API, якщо розмір не "
"запитано."

#: authentik/admin/models.py
msgid "Maximum page size"
msgstr "Максимальний розмір сторінки"

#: authentik/admin/models.py
msgid "System settings"
msgstr "Системні налаштування"

#: authentik/admin/models.py
msgid "Version history"
msgstr "Історія версій"

#: authentik/admin/tasks.py
msgid "Update latest version info."
msgstr "Оновити відомості про останню версію."

#: authentik/admin/tasks.py
#, python-brace-format
msgid "New version {version} available!"
msgstr "Доступна нова версія {version}!"

#: authentik/api/v3/schema/query.py
msgid "Which field to use when ordering the results."
msgstr "За яким полем сортувати результати."

#: authentik/api/v3/schema/query.py
msgid "A page number within the paginated result set."
msgstr "Номер сторінки в наборі результатів із пагінацією."

#: authentik/api/v3/schema/query.py
msgid "Number of results to return per page."
msgstr "Кількість результатів на сторінку."

#: authentik/api/v3/schema/query.py
msgid "A search term."
msgstr "Пошуковий запит."

#: authentik/api/v3/schema/response.py
msgid "Generic API Error"
msgstr "Загальна помилка API"

#: authentik/api/v3/schema/response.py
msgid "Validation Error"
msgstr "Помилка валідації"

#: authentik/blueprints/api.py
msgid "Blueprint file does not exist"
msgstr "Файл blueprint не існує"

#: authentik/blueprints/api.py
msgid "Context must be valid JSON"
msgstr "Контекст має бути коректним JSON"

#: authentik/blueprints/api.py
msgid "Context must be a JSON object"
msgstr "Контекст має бути об'єктом JSON"

#: authentik/blueprints/api.py
msgid "Failed to validate blueprint"
msgstr "Не вдалося провалідувати blueprint"

#: authentik/blueprints/api.py
msgid "Either path or content must be set."
msgstr "Потрібно вказати або шлях, або вміст."

#: authentik/blueprints/api.py
#, python-brace-format
msgid "User lacks permission to create {model}"
msgstr "Користувач не має дозволу на створення {model}"

#: authentik/blueprints/api.py
#, python-brace-format
msgid "Invalid blueprint file: {exc}"
msgstr "Недійсний файл блупринта: {exc}"

#: authentik/blueprints/models.py
msgid "Managed by authentik"
msgstr "Керується authentik"

#: authentik/blueprints/models.py
msgid ""
"Objects that are managed by authentik. These objects are created and updated"
" automatically. This flag only indicates that an object can be overwritten "
"by migrations. You can still modify the objects via the API, but expect "
"changes to be overwritten in a later update."
msgstr ""
"Об'єкти, якими керує authentik. Ці об'єкти створюються й оновлюються "
"автоматично. Цей прапорець лише вказує, що об'єкт може бути перезаписаний "
"міграціями. Ви все ще можете змінювати об'єкти через API, але врахуйте, що "
"зміни буде перезаписано під час наступного оновлення."

#: authentik/blueprints/models.py
msgid "Blueprint Instance"
msgstr "Екземпляр blueprint"

#: authentik/blueprints/models.py
msgid "Blueprint Instances"
msgstr "Екземпляри blueprint"

#: authentik/blueprints/v1/exporter.py
#, python-brace-format
msgid "authentik Export - {date}"
msgstr "Експорт authentik — {date}"

#: authentik/blueprints/v1/tasks.py
msgid "Find blueprints as `blueprints_find` does, but return a safe dict."
msgstr ""
"Знайти blueprint так само, як це робить `blueprints_find`, але повернути "
"безпечний словник."

#: authentik/blueprints/v1/tasks.py
msgid "Find blueprints and check if they need to be created in the database."
msgstr "Знайти blueprint і перевірити, чи їх потрібно створити в базі даних."

#: authentik/blueprints/v1/tasks.py
msgid "Apply single blueprint."
msgstr "Застосувати один blueprint."

#: authentik/blueprints/v1/tasks.py
msgid "Remove blueprints which couldn't be fetched."
msgstr "Видалити blueprint, які не вдалося отримати."

#: authentik/brands/models.py
msgid ""
"Domain that activates this brand. Can be a superset, i.e. `a.b` for `aa.b` "
"and `ba.b`"
msgstr ""
"Домен, що активує цей бренд. Може бути надмножиною, тобто `a.b` для `aa.b` і"
" `ba.b`"

#: authentik/brands/models.py
#, python-brace-format
msgid ""
"URL template for the vector tile source used by the events map. Supports XYZ"
" templates with {z}, {x} and {y} placeholders, or pmtiles:// archive URLs. "
"When empty, the frontend uses the bundled hexworld basemap. This value is "
"part of the brand information served to unauthenticated clients; do not "
"embed API keys or other credentials in it."
msgstr ""
"Шаблон URL для джерела векторних тайлів, який використовує карта подій. "
"Підтримуються шаблони XYZ із плейсхолдерами {z}, {x} та {y}, а також URL "
"архівів pmtiles://. Якщо порожньо, фронтенд використовує вбудовану базову "
"карту hexworld. Це значення входить до інформації про бренд, яка надається "
"неавтентифікованим клієнтам; не вбудовуйте в нього ключі API або інші "
"облікові дані."

#: authentik/brands/models.py
msgid ""
"When set, external users will be redirected to this application after "
"authenticating."
msgstr ""
"Якщо задано, зовнішніх користувачів буде перенаправлено до цього застосунку "
"після автентифікації."

#: authentik/brands/models.py
msgid "Web Certificate used by the authentik Core webserver."
msgstr "Вебсертифікат, який використовує вебсервер ядра authentik."

#: authentik/brands/models.py
msgid "Certificates used for client authentication."
msgstr "Сертифікати, що використовуються для автентифікації клієнтів."

#: authentik/brands/models.py
msgid "Brand"
msgstr "Бренд"

#: authentik/brands/models.py
msgid "Brands"
msgstr "Бренди"

#: authentik/brands/models.py
msgid "Brand Client Certificate"
msgstr "Клієнтський сертифікат бренду"

#: authentik/brands/models.py
msgid "Brand Client Certificates"
msgstr "Клієнтські сертифікати бренду"

#: authentik/common/oauth/constants.py
msgid "Based on the Hashed User ID"
msgstr "На основі хешованого ідентифікатора користувача"

#: authentik/common/oauth/constants.py
msgid "Based on user ID"
msgstr "На основі ідентифікатора користувача"

#: authentik/common/oauth/constants.py
msgid "Based on user UUID"
msgstr "На основі UUID користувача"

#: authentik/common/oauth/constants.py
msgid "Based on the username"
msgstr "На основі імені користувача"

#: authentik/common/oauth/constants.py
msgid "Based on the User's Email. This is recommended over the UPN method."
msgstr ""
"На основі електронної пошти користувача. Рекомендується замість методу UPN."

#: authentik/common/oauth/constants.py
msgid ""
"Based on the User's UPN, only works if user has a 'upn' attribute set. Use "
"this method only if you have different UPN and Mail domains."
msgstr ""
"На основі UPN користувача; працює, лише якщо в користувача встановлено "
"атрибут 'upn'. Використовуйте цей метод, лише якщо ваші домени UPN і пошти "
"різні."

#: authentik/common/saml/exceptions.py
msgid "Cannot decode SAML request."
msgstr "Не вдається декодувати SAML-запит."

#: authentik/common/saml/exceptions.py
msgid "Verification Certificate configured, but request is not signed."
msgstr "Сертифікат перевірки налаштовано, але запит не підписано."

#: authentik/common/saml/exceptions.py
msgid "Failed to verify signature"
msgstr "Не вдалося перевірити підпис"

#: authentik/common/saml/exceptions.py
msgid ""
"The ACS URL in the request does not match the ACS URL configured on the "
"provider."
msgstr ""

#: authentik/common/saml/parsers/logout_response.py
msgid "Cannot decode SAML response."
msgstr "Не вдалося декодувати відповідь SAML."

#: authentik/core/api/application_entitlements.py
msgid "User does not have access to application."
msgstr "Користувач не має доступу до застосунку."

#: authentik/core/api/application_entitlements.py
msgid ""
"Entitlements assigned to this user, directly or through a group, regardless "
"of the user's access to the application."
msgstr ""
"Права доступу, призначені цьому користувачу напряму або через групу, "
"незалежно від доступу користувача до застосунку."

#: authentik/core/api/applications.py
#, python-brace-format
msgid "The slug '{slug}' is reserved and cannot be used for applications."
msgstr ""
"Slug '{slug}' зарезервовано, його не можна використовувати для застосунків."

#: authentik/core/api/groups.py
#, python-brace-format
msgid ""
"User does not have permission to set superuser status to {superuser_status}."
msgstr ""
"Користувач не має дозволу встановлювати статус суперкористувача на "
"{superuser_status}."

#: authentik/core/api/groups.py
msgid "User does not have permission to add members to this group."
msgstr "Користувач не має дозволу додавати учасників до цієї групи."

#: authentik/core/api/groups.py authentik/core/api/users.py
msgid "User does not have permission to add members to a superuser group."
msgstr ""
"Користувач не має дозволу додавати учасників до групи суперкористувачів."

#: authentik/core/api/groups.py
msgid "User does not have permission to add a superuser parent group."
msgstr ""
"Користувач не має дозволу додавати батьківську групу суперкористувача."

#: authentik/core/api/groups.py authentik/core/api/users.py
msgid "User does not have permission to assign roles."
msgstr "Користувач не має дозволу призначати ролі."

#: authentik/core/api/object_attributes.py
msgid "Unique cannot be enabled for arrays."
msgstr "Унікальність не можна ввімкнути для масивів."

#: authentik/core/api/providers.py
msgid ""
"When not set all providers are returned. When set to true, only backchannel "
"providers are returned. When set to false, backchannel providers are "
"excluded"
msgstr ""
"Якщо не задано, повертаються всі провайдери. Якщо встановлено true, "
"повертаються лише backchannel-провайдери. Якщо встановлено false, "
"backchannel-провайдери виключаються"

#: authentik/core/api/users.py
msgid "No leading or trailing slashes allowed."
msgstr "Початкові та кінцеві слеші не дозволені."

#: authentik/core/api/users.py
msgid "No empty segments in user path allowed."
msgstr "Порожні сегменти в шляху користувача не дозволені."

#: authentik/core/api/users.py
msgid "Can't create internal service accounts"
msgstr "Не вдалося створити внутрішні сервісні облікові записи"

#: authentik/core/api/users.py
msgid "Can't change internal service account to other user type."
msgstr ""
"Не вдалося змінити тип внутрішнього сервісного облікового запису на інший."

#: authentik/core/api/users.py
msgid "Cannot set both password and password_hash. Use only one."
msgstr ""
"Не можна одночасно задати password і password_hash. Використовуйте лише "
"одне."

#: authentik/core/api/users.py
msgid "Can't modify internal service account users"
msgstr "Не вдалося змінити внутрішніх сервісних користувачів"

#: authentik/core/api/users.py
msgid "This field is required."
msgstr "Це поле обов'язкове."

#: authentik/core/api/users.py
msgid ""
"Import a valid password hash even when its parameters do not match "
"authentik's current password hashing settings."
msgstr ""
"Імпортувати дійсний хеш пароля, навіть якщо його параметри не збігаються з "
"поточними налаштуваннями хешування паролів authentik."

#: authentik/core/api/users.py
#, python-format
msgid "%(reason)s Set \"override\" to true to import it anyway."
msgstr "%(reason)s Установіть \"override\" у true, щоб усе одно імпортувати."

#: authentik/core/api/users.py
msgid "No recovery flow set."
msgstr "Потік відновлення не налаштовано."

#: authentik/core/api/users.py
msgid "Recovery flow not applicable to user"
msgstr "Потік відновлення не застосовний до користувача"

#: authentik/core/api/users.py
msgid "A user/group with these details already exists"
msgstr "Користувач або група з такими даними вже існує"

#: authentik/core/api/users.py
msgid "Unable to create user"
msgstr "Не вдалося створити користувача"

#: authentik/core/api/users.py
msgid "Unknown error occurred"
msgstr "Сталася невідома помилка"

#: authentik/core/api/users.py
msgid "User does not have an email address set."
msgstr "Користувач не має встановленої адреси електронної пошти."

#: authentik/core/api/users.py
msgid "Email stage not found."
msgstr "Етап електронної пошти не знайдено."

#: authentik/core/apps.py
msgid "Applications with no policies bound can be accessed by any user."
msgstr "Застосунки без прив'язаних політик доступні будь-якому користувачу."

#: authentik/core/models.py
msgid "name"
msgstr "name"

#: authentik/core/models.py
msgid "Users added to this group will be superusers."
msgstr "Користувачі, додані до цієї групи, стануть суперкористувачами."

#: authentik/core/models.py
msgid "Group"
msgstr "Група"

#: authentik/core/models.py
msgid "Groups"
msgstr "Групи"

#: authentik/core/models.py
msgid "Add user to group"
msgstr "Додати користувача до групи"

#: authentik/core/models.py
msgid "Remove user from group"
msgstr "Видалити користувача з групи"

#: authentik/core/models.py
msgid "Enable superuser status"
msgstr "Увімкнути статус суперкористувача"

#: authentik/core/models.py
msgid "Disable superuser status"
msgstr "Вимкнути статус суперкористувача"

#: authentik/core/models.py
msgid "Group Parentage Node"
msgstr "Вузол батьківства групи"

#: authentik/core/models.py
msgid "Group Parentage Nodes"
msgstr "Вузли батьківства групи"

#: authentik/core/models.py
msgid "User's display name."
msgstr "Відображуване ім'я користувача."

#: authentik/core/models.py authentik/providers/oauth2/models.py
#: authentik/providers/saml/models.py
msgid "User"
msgstr "Користувач"

#: authentik/core/models.py
msgid "Users"
