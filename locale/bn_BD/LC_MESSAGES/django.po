#: authentik/admin/files/api.py
#, python-brace-format
msgid "File size ({file.size}B) exceeds maximum allowed "
msgstr "ফাইলের আকার ({file.size}B) সর্বোচ্চ সীমা অতিক্রম করেছে"

#: authentik/admin/files/validation.py
msgid "File name cannot be empty"
msgstr "ফাইলের নাম খালি রাখা যাবে না"

#: authentik/admin/files/validation.py
#, python-format
msgid ""
"File name can only contain letters (a-z, A-Z), numbers (0-9), dots (.), "
"hyphens (-), underscores (_), forward slashes (/), and the placeholder "
"%(theme)s for theme-specific files"
msgstr ""
"ফাইলের নামে শুধুমাত্র অক্ষর (a-z, A-Z), সংখ্যা (0-9), ডট (.), হাইফেন (-), "
"আন্ডারস্কোর (_), ফরওয়ার্ড স্ল্যাশ (/), এবং থিম-নির্দিষ্ট ফাইলের জন্য "
"প্লেসহোল্ডার %(theme)s ব্যবহার করা যাবে"

#: authentik/admin/files/validation.py
msgid "File name cannot contain duplicate /"
msgstr "ফাইলের নামে পুনরাবৃত্ত / থাকতে পারবে না"

#: authentik/admin/files/validation.py
msgid "Absolute paths are not allowed"
msgstr "অ্যাবসোলিউট পাথ ব্যবহার করা যাবে না"

#: authentik/admin/files/validation.py
msgid "Parent directory references ('..') are not allowed"
msgstr "প্যারেন্ট ডিরেক্টরি রেফারেন্স ('..') অনুমোদিত নয়"

#: authentik/admin/files/validation.py
msgid "Paths cannot start with '.'"
msgstr "পাথ '.' দিয়ে শুরু করা যাবে না"

#: authentik/admin/files/validation.py
#, python-brace-format
msgid "File name too long (max {MAX_FILE_NAME_LENGTH} characters)"
msgstr "ফাইলের নাম অনেক বড় (সর্বোচ্চ {MAX_FILE_NAME_LENGTH} অক্ষর)"

#: authentik/admin/files/validation.py
#, python-brace-format
msgid "Path component too long (max {MAX_PATH_COMPONENT_LENGTH} characters)"
msgstr "পাথ কম্পোনেন্ট অনেক বড় (সর্বোচ্চ {MAX_PATH_COMPONENT_LENGTH} অক্ষর)"

#: authentik/admin/models.py
msgid "Version history"
msgstr "সংস্করণ ইতিহাস"

#: authentik/admin/tasks.py
msgid "Update latest version info."
msgstr "সর্বশেষ সংস্করণের তথ্য আপডেট করুন।"

#: authentik/admin/tasks.py
#, python-brace-format
msgid "New version {version} available!"
msgstr "নতুন সংস্করণ {version} উপলব্ধ!"

#: authentik/api/v3/schema/query.py
msgid "Which field to use when ordering the results."
msgstr "ফলাফল সাজানোর জন্য কোন ফিল্ড ব্যবহার করা হবে।"

#: authentik/api/v3/schema/query.py
msgid "A page number within the paginated result set."
msgstr "পেজিনেটেড ফলাফল সেটের মধ্যে একটি পৃষ্ঠা নম্বর।"

#: authentik/api/v3/schema/query.py
msgid "Number of results to return per page."
msgstr "প্রতি পৃষ্ঠায় প্রদর্শিত ফলাফলের সংখ্যা।"

#: authentik/api/v3/schema/query.py
msgid "A search term."
msgstr "একটি অনুসন্ধান শব্দ।"

#: authentik/api/v3/schema/response.py
msgid "Generic API Error"
msgstr "সাধারণ API ত্রুটি"

#: authentik/api/v3/schema/response.py
msgid "Validation Error"
msgstr "ভ্যালিডেশন ত্রুটি"

#: authentik/blueprints/api.py
msgid "Blueprint file does not exist"
msgstr "ব্লুপ্রিন্ট ফাইলটি বিদ্যমান নেই"

#: authentik/blueprints/api.py
msgid "Context must be valid JSON"
msgstr "কনটেক্সট অবশ্যই বৈধ JSON হতে হবে"

#: authentik/blueprints/api.py
msgid "Context must be a JSON object"
msgstr "কনটেক্সট অবশ্যই একটি JSON অবজেক্ট হতে হবে"

#: authentik/blueprints/api.py
msgid "Failed to validate blueprint"
msgstr "ব্লুপ্রিন্ট যাচাই করতে ব্যর্থ হয়েছে"

#: authentik/blueprints/api.py
msgid "Either path or content must be set."
msgstr "পাথ অথবা কনটেন্ট এর যেকোনো একটি অবশ্যই সেট করতে হবে।"

#: authentik/blueprints/api.py
#, python-brace-format
msgid "User lacks permission to create {model}"
msgstr "{model} তৈরি করার অনুমতি ব্যবহারকারীর নেই"

#: authentik/blueprints/models.py
msgid "Managed by authentik"
msgstr "authentik দ্বারা পরিচালিত"

#: authentik/blueprints/models.py
msgid ""
"Objects that are managed by authentik. These objects are created and updated"
" automatically. This flag only indicates that an object can be overwritten "
"by migrations. You can still modify the objects via the API, but expect "
"changes to be overwritten in a later update."
msgstr ""
"authentik দ্বারা পরিচালিত অবজেক্টসমূহ। এই অবজেক্টগুলো স্বয়ংক্রিয়ভাবে তৈরি "
"ও আপডেট করা হয়। এই ফ্ল্যাগটি শুধু নির্দেশ করে যে একটি অবজেক্ট মাইগ্রেশনের "
"মাধ্যমে ওভাররাইট করা যেতে পারে। আপনি এখনও API-এর মাধ্যমে অবজেক্টগুলো "
"পরিবর্তন করতে পারবেন, তবে পরবর্তী আপডেটে পরিবর্তনগুলো ওভাররাইট হয়ে যেতে "
"পারে বলে আশা করুন।"

#: authentik/blueprints/models.py
msgid "Blueprint Instance"
msgstr "ব্লুপ্রিন্ট ইনস্ট্যান্স"

#: authentik/blueprints/models.py
msgid "Blueprint Instances"
msgstr "ব্লুপ্রিন্ট ইনস্ট্যান্সসমূহ"

#: authentik/blueprints/v1/exporter.py
#, python-brace-format
msgid "authentik Export - {date}"
msgstr "authentik এক্সপোর্ট - {date}"

#: authentik/blueprints/v1/tasks.py
msgid "Find blueprints as `blueprints_find` does, but return a safe dict."
msgstr ""
"`blueprints_find`-এর মতোই ব্লুপ্রিন্ট খুঁজে বের করে, তবে একটি নিরাপদ dict "
"রিটার্ন করে।"

#: authentik/blueprints/v1/tasks.py
msgid "Find blueprints and check if they need to be created in the database."
msgstr ""
"ব্লুপ্রিন্ট খুঁজে বের করে এবং যাচাই করে যে সেগুলো ডেটাবেজে তৈরি করা প্রয়োজন"
" কিনা।"

#: authentik/blueprints/v1/tasks.py
msgid "Apply single blueprint."
msgstr "একটি একক ব্লুপ্রিন্ট প্রয়োগ করুন।"

#: authentik/blueprints/v1/tasks.py
msgid "Remove blueprints which couldn't be fetched."
msgstr "যেসব ব্লুপ্রিন্ট আনা সম্ভব হয়নি সেগুলো সরিয়ে ফেলুন।"

#: authentik/brands/models.py
msgid ""
"Domain that activates this brand. Can be a superset, i.e. `a.b` for `aa.b` "
"and `ba.b`"
msgstr ""
"এই ব্র্যান্ড সক্রিয় করে এমন ডোমেইন। এটি একটি সুপারসেট হতে পারে, যেমন `aa.b`"
" এবং `ba.b`-এর জন্য `a.b`।"

#: authentik/brands/models.py
msgid ""
"When set, external users will be redirected to this application after "
"authenticating."
msgstr ""
"সেট করা থাকলে, বাহ্যিক ব্যবহারকারীরা প্রমাণীকরণের পর এই অ্যাপ্লিকেশনে "
"পুনঃনির্দেশিত হবেন।"

#: authentik/brands/models.py
msgid "Web Certificate used by the authentik Core webserver."
msgstr "authentik কোর ওয়েবসার্ভার দ্বারা ব্যবহৃত ওয়েব সার্টিফিকেট।"

#: authentik/brands/models.py
msgid "Certificates used for client authentication."
msgstr "ক্লায়েন্ট প্রমাণীকরণের জন্য ব্যবহৃত সার্টিফিকেটসমূহ।"

#: authentik/brands/models.py
msgid "Brand"
msgstr "ব্র্যান্ড"

#: authentik/brands/models.py
msgid "Brands"
msgstr "ব্র্যান্ডসমূহ"

#: authentik/brands/models.py
msgid "Brand Client Certificate"
msgstr "ব্র্যান্ড ক্লায়েন্ট সার্টিফিকেট"

#: authentik/brands/models.py
msgid "Brand Client Certificates"
msgstr "ব্র্যান্ড ক্লায়েন্ট সার্টিফিকেটসমূহ"

#: authentik/common/oauth/constants.py
msgid "Based on the Hashed User ID"
msgstr "হ্যাশড ইউজার আইডির ভিত্তিতে"

#: authentik/common/oauth/constants.py
msgid "Based on user ID"
msgstr "ইউজার আইডির ভিত্তিতে"

#: authentik/common/oauth/constants.py
msgid "Based on user UUID"
msgstr "ইউজার UUID-র ভিত্তিতে"

#: authentik/common/oauth/constants.py
msgid "Based on the username"
msgstr "ইউজারনেমের ভিত্তিতে"

#: authentik/common/oauth/constants.py
msgid "Based on the User's Email. This is recommended over the UPN method."
msgstr "ব্যবহারকারীর ইমেইলের ভিত্তিতে। UPN পদ্ধতির চেয়ে এটি সুপারিশ করা হয়।"

#: authentik/common/oauth/constants.py
msgid ""
"Based on the User's UPN, only works if user has a 'upn' attribute set. Use "
"this method only if you have different UPN and Mail domains."
msgstr ""
"ব্যবহারকারীর UPN-এর ভিত্তিতে, শুধুমাত্র তখনই কাজ করে যখন ব্যবহারকারীর একটি "
"'upn' অ্যাট্রিবিউট সেট করা থাকে। শুধুমাত্র তখনই এই পদ্ধতি ব্যবহার করুন যখন "
"আপনার ভিন্ন UPN এবং মেইল ডোমেইন থাকে।"

#: authentik/core/api/application_entitlements.py
msgid "User does not have access to application."
msgstr "ব্যবহারকারীর অ্যাপ্লিকেশনে অ্যাক্সেস নেই।"

#: authentik/core/api/applications.py
#, python-brace-format
msgid "The slug '{slug}' is reserved and cannot be used for applications."
msgstr "স্লাগ '{slug}' সংরক্ষিত এবং অ্যাপ্লিকেশনের জন্য ব্যবহার করা যাবে না।"

#: authentik/core/api/groups.py
msgid "User does not have permission to add members to this group."
msgstr "এই গ্রুপে সদস্য যোগ করার অনুমতি ব্যবহারকারীর নেই।"

#: authentik/core/api/object_attributes.py
msgid "Unique cannot be enabled for arrays."
msgstr "অ্যারের জন্য Unique সক্রিয় করা যাবে না।"

#: authentik/core/api/providers.py
msgid ""
"When not set all providers are returned. When set to true, only backchannel "
"providers are returned. When set to false, backchannel providers are "
"excluded"
msgstr ""
"সেট করা না থাকলে সব প্রোভাইডার রিটার্ন করা হয়। true সেট করা থাকলে, "
"শুধুমাত্র ব্যাকচ্যানেল প্রোভাইডার রিটার্ন করা হয়। false সেট করা থাকলে, "
"ব্যাকচ্যানেল প্রোভাইডার বাদ দেওয়া হয়"

#: authentik/core/api/users.py
msgid "No leading or trailing slashes allowed."
msgstr "শুরুতে বা শেষে স্ল্যাশ ব্যবহারের অনুমতি নেই।"

#: authentik/core/api/users.py
msgid "No empty segments in user path allowed."
msgstr "ইউজার পাথে কোনো খালি সেগমেন্টের অনুমতি নেই।"

#: authentik/core/api/users.py
msgid "Can't create internal service accounts"
msgstr "ইন্টারনাল সার্ভিস অ্যাকাউন্ট তৈরি করা যাবে না"

#: authentik/core/api/users.py
msgid "Can't change internal service account to other user type."
msgstr "ইন্টারনাল সার্ভিস অ্যাকাউন্টকে অন্য ইউজার টাইপে পরিবর্তন করা যাবে না।"

#: authentik/core/api/users.py
msgid "User does not have permission to add members to a superuser group."
msgstr "সুপারইউজার গ্রুপে সদস্য যোগ করার অনুমতি ব্যবহারকারীর নেই।"

#: authentik/core/api/users.py
msgid "User does not have permission to assign roles."
msgstr "রোল বরাদ্দ করার অনুমতি ব্যবহারকারীর নেই।"

#: authentik/core/api/users.py
msgid "Cannot set both password and password_hash. Use only one."
msgstr ""
"password এবং password_hash উভয়ই একসাথে সেট করা যাবে না। শুধুমাত্র একটি "
"ব্যবহার করুন।"

#: authentik/core/api/users.py
msgid "Can't modify internal service account users"
msgstr "ইন্টারনাল সার্ভিস অ্যাকাউন্ট ব্যবহারকারীদের পরিবর্তন করা যাবে না"

#: authentik/core/api/users.py
msgid "filter: failed to parse JSON"
msgstr "filter: JSON পার্স করতে ব্যর্থ হয়েছে"

#: authentik/core/api/users.py
msgid "filter: value must be key:value mapping"
msgstr "filter: মান অবশ্যই key:value ম্যাপিং হতে হবে"

#: authentik/core/api/users.py
msgid "No recovery flow set."
msgstr "কোনো রিকভারি ফ্লো সেট করা নেই।"

#: authentik/core/api/users.py
msgid "Recovery flow not applicable to user"
msgstr "রিকভারি ফ্লো ব্যবহারকারীর জন্য প্রযোজ্য নয়"

#: authentik/core/api/users.py
msgid "A user/group with these details already exists"
msgstr "এই তথ্য সহ একটি ব্যবহারকারী/গ্রুপ ইতিমধ্যে বিদ্যমান"

#: authentik/core/api/users.py
msgid "Unable to create user"
msgstr "ব্যবহারকারী তৈরি করা সম্ভব হয়নি"

#: authentik/core/api/users.py
msgid "Unknown error occurred"
msgstr "অজানা ত্রুটি ঘটেছে"

#: authentik/core/api/users.py
msgid "User does not have an email address set."
msgstr "ব্যবহারকারীর কোনো ইমেইল ঠিকানা সেট করা নেই।"

#: authentik/core/api/users.py
msgid "Email stage not found."
msgstr "ইমেইল স্টেজ খুঁজে পাওয়া যায়নি।"

#: authentik/core/api/users.py
msgid "This field is required."
msgstr "এই ফিল্ডটি আবশ্যক।"

#: authentik/core/apps.py
msgid "Applications with no policies bound can be accessed by any user."
msgstr ""
"যেসব অ্যাপ্লিকেশনে কোনো পলিসি যুক্ত নেই, সেগুলোতে যেকোনো ব্যবহারকারী প্রবেশ "
"করতে পারেন।"

#: authentik/core/models.py
msgid "name"
msgstr "নাম"

#: authentik/core/models.py
msgid "Users added to this group will be superusers."
msgstr "এই গ্রুপে যোগ করা ব্যবহারকারীরা সুপারইউজার হবেন।"

#: authentik/core/models.py
msgid "Group"
msgstr "গ্রুপ"

#: authentik/core/models.py
msgid "Groups"
msgstr "গ্রুপসমূহ"

#: authentik/core/models.py
msgid "Add user to group"
msgstr "গ্রুপে ব্যবহারকারী যোগ করুন"

#: authentik/core/models.py
msgid "Remove user from group"
msgstr "গ্রুপ থেকে ব্যবহারকারী সরান"

#: authentik/core/models.py
msgid "Enable superuser status"
msgstr "সুপারইউজার স্ট্যাটাস সক্রিয় করুন"

