#: authentik/admin/api/settings.py
#, python-brace-format
msgid "Value for flag {flag_key} needs to be of type {type}."
msgstr "Karoga {flag_key} vērtības veidam jābūt {type}."

#: authentik/admin/files/validation.py
msgid "File name cannot be empty"
msgstr "Faila nosaukums nedrīkst būt tukšs"

#: authentik/admin/files/validation.py
#, python-format
msgid ""
"File name can only contain letters (a-z, A-Z), numbers (0-9), dots (.), "
"hyphens (-), underscores (_), forward slashes (/), and the placeholder "
"%(theme)s for theme-specific files"
msgstr ""
"Faila nosaukumā drīkst būt tikai burti (a-z, A-Z), cipari (0-9), punkti (.),"
" defises (-), pasvītras (_), slīpsvītras (/) un vietturis %(theme)s motīvam "
"specifiskiem failiem"

#: authentik/admin/files/validation.py
msgid "File name cannot contain duplicate /"
msgstr "Faila nosaukumā nedrīkst būt dubultas /"

#: authentik/admin/files/validation.py
msgid "Absolute paths are not allowed"
msgstr "Absolūtie ceļi nav atļauti"

#: authentik/admin/files/validation.py
msgid "Parent directory references ('..') are not allowed"
msgstr "Atsauces uz vecākdirektoriju ('..') nav atļautas"

#: authentik/admin/files/validation.py
msgid "Paths cannot start with '.'"
msgstr "Ceļi nedrīkst sākties ar '.'"

#: authentik/admin/models.py
msgid "Configure how authentik should show avatars for users."
msgstr "Iestatiet, kā authentik rāda lietotāju avatārus."

#: authentik/admin/models.py
msgid "Enter a valid URL, for example https://authentik.company"
msgstr "Ievadiet derīgu URL, piemēram, https://authentik.company"

#: authentik/admin/models.py
msgid ""
"Configure the base URL under which this authentik instance is reachable, "
"e.g. https://authentik.company"
msgstr ""
"Iestatiet bāzes URL, kurā šī authentik instance ir sasniedzama, piemēram, "
"https://authentik.company"

#: authentik/admin/models.py
msgid "Enable the ability for users to change their name."
msgstr "Ļaut lietotājiem mainīt savu vārdu."

#: authentik/admin/models.py
msgid "Enable the ability for users to change their email address."
msgstr "Ļaut lietotājiem mainīt savu e-pasta adresi."

#: authentik/admin/models.py
msgid "Enable the ability for users to change their username."
msgstr "Ļaut lietotājiem mainīt savu lietotājvārdu."

#: authentik/admin/models.py
msgid ""
"Events will be deleted after this duration.(Format: "
"weeks=3;days=2;hours=3,seconds=2)."
msgstr ""
"Notikumi tiks dzēsti pēc šī laika. (Formāts: "
"weeks=3;days=2;hours=3,seconds=2)."

#: authentik/admin/models.py
msgid "Reputation cannot decrease lower than this value. Zero or negative."
msgstr "Reputācija nevar samazināties zem šīs vērtības. Nulle vai negatīva."

#: authentik/admin/models.py
msgid "Reputation cannot increase higher than this value. Zero or positive."
msgstr "Reputācija nevar palielināties virs šīs vērtības. Nulle vai pozitīva."

#: authentik/admin/models.py
msgid "The option configures the footer links on the flow executor pages."
msgstr "Šeit iestata kājenes saites plūsmas izpildītāja lapās."

#: authentik/admin/models.py
msgid ""
"When enabled, all the events caused by a user will be deleted upon the "
"user's deletion."
msgstr ""
"Ja iespējots, dzēšot lietotāju, tiks dzēsti arī visi viņa izraisītie "
"notikumi."

#: authentik/admin/models.py
msgid "Globally enable/disable impersonation."
msgstr "Globāli iespējot/atspējot uzdošanos."

#: authentik/admin/models.py
msgid "Require administrators to provide a reason for impersonating a user."
msgstr ""
"Prasīt administratoriem norādīt iemeslu, kad tie uzdodas par lietotāju."

#: authentik/admin/models.py
msgid "Default token duration"
msgstr "Noklusējuma marķiera ilgums"

#: authentik/admin/models.py
msgid "Default token length"
msgstr "Noklusējuma marķiera garums"

#: authentik/admin/models.py
msgid "Default page size for API responses, if no size was requested."
msgstr "Noklusējuma lapas izmērs API atbildēm, ja izmērs nav pieprasīts."

#: authentik/admin/models.py
msgid "Maximum page size"
msgstr "Maksimālais lapas izmērs"

#: authentik/admin/models.py
msgid "System settings"
msgstr "Sistēmas iestatījumi"

#: authentik/admin/models.py
msgid "Version history"
msgstr "Versiju vēsture"

#: authentik/admin/tasks.py
msgid "Update latest version info."
msgstr "Atjaunināt informāciju par jaunāko versiju."

#: authentik/admin/tasks.py
#, python-brace-format
msgid "New version {version} available!"
msgstr "Pieejama jauna versija {version}!"

#: authentik/api/v3/schema/query.py
msgid "Which field to use when ordering the results."
msgstr "Lauks, pēc kura kārtot rezultātus."

#: authentik/api/v3/schema/query.py
msgid "A page number within the paginated result set."
msgstr "Lapas numurs lapotajā rezultātu kopā."

#: authentik/api/v3/schema/query.py
msgid "Number of results to return per page."
msgstr "Vienā lapā atgriežamo rezultātu skaits."

#: authentik/api/v3/schema/query.py
msgid "A search term."
msgstr "Meklēšanas vārds."

#: authentik/api/v3/schema/response.py
msgid "Generic API Error"
msgstr "Vispārīga API kļūda"

#: authentik/api/v3/schema/response.py
msgid "Validation Error"
msgstr "Pārbaudes kļūda"

#: authentik/blueprints/api.py
msgid "Blueprint file does not exist"
msgstr "Plāna fails nepastāv"

#: authentik/blueprints/api.py
msgid "Context must be valid JSON"
msgstr "Kontekstam jābūt derīgam JSON"

#: authentik/blueprints/api.py
msgid "Context must be a JSON object"
msgstr "Kontekstam jābūt JSON objektam"

#: authentik/blueprints/api.py
msgid "Failed to validate blueprint"
msgstr "Neizdevās pārbaudīt plānu"

#: authentik/blueprints/api.py
msgid "Either path or content must be set."
msgstr "Jābūt iestatītam ceļam vai saturam."

#: authentik/blueprints/api.py
#, python-brace-format
msgid "User lacks permission to create {model}"
msgstr "Lietotājam nav atļaujas izveidot {model}"

#: authentik/blueprints/api.py
#, python-brace-format
msgid "Invalid blueprint file: {exc}"
msgstr "Nederīgs plāna fails: {exc}"

#: authentik/blueprints/models.py
msgid "Managed by authentik"
msgstr "Pārvalda authentik"

#: authentik/blueprints/models.py
msgid ""
"Objects that are managed by authentik. These objects are created and updated"
" automatically. This flag only indicates that an object can be overwritten "
"by migrations. You can still modify the objects via the API, but expect "
"changes to be overwritten in a later update."
msgstr ""
"Objekti, ko pārvalda authentik. Šie objekti tiek izveidoti un atjaunināti "
"automātiski. Šis karogs tikai norāda, ka migrācijas var objektu pārrakstīt. "
"Objektus joprojām var mainīt ar API, taču jārēķinās, ka izmaiņas vēlākā "
"atjauninājumā tiks pārrakstītas."

#: authentik/blueprints/models.py
msgid "Blueprint Instance"
msgstr "Plāna instance"

#: authentik/blueprints/models.py
msgid "Blueprint Instances"
msgstr "Plāna instances"

#: authentik/blueprints/v1/exporter.py
#, python-brace-format
msgid "authentik Export - {date}"
msgstr "authentik eksports - {date}"

#: authentik/blueprints/v1/tasks.py
msgid "Find blueprints as `blueprints_find` does, but return a safe dict."
msgstr ""
"Atrast plānus tāpat kā `blueprints_find`, bet atgriezt drošu vārdnīcu."

#: authentik/blueprints/v1/tasks.py
msgid "Find blueprints and check if they need to be created in the database."
msgstr "Atrast plānus un pārbaudīt, vai tie jāizveido datubāzē."

#: authentik/blueprints/v1/tasks.py
msgid "Apply single blueprint."
msgstr "Lietot vienu plānu."

#: authentik/blueprints/v1/tasks.py
msgid "Remove blueprints which couldn't be fetched."
msgstr "Noņemt plānus, kurus neizdevās ielādēt."

#: authentik/brands/models.py
msgid ""
"Domain that activates this brand. Can be a superset, i.e. `a.b` for `aa.b` "
"and `ba.b`"
msgstr ""
"Domēns, kas aktivizē šo zīmolu. Var būt virskopa, t. i., `a.b` domēniem "
"`aa.b` un `ba.b`"

#: authentik/brands/models.py
#, python-brace-format
msgid ""
"URL template for the vector tile source used by the events map. Supports XYZ"
" templates with {z}, {x} and {y} placeholders, or pmtiles:// archive URLs. "
"When empty, the frontend uses the bundled hexworld basemap. This value is "
"part of the brand information served to unauthenticated clients; do not "
"embed API keys or other credentials in it."
msgstr ""
"URL veidne vektoru fragmentu avotam, ko izmanto notikumu karte. Atbalsta XYZ"
" veidnes ar vietturiem {z}, {x} un {y} vai pmtiles:// arhīva URL. Ja tukšs, "
"priekšgals izmanto iebūvēto hexworld pamatkarti. Šī vērtība ir daļa no "
"zīmola informācijas, ko nosūta neautentificētiem klientiem; neiekļaujiet "
"tajā API atslēgas vai citus akreditācijas datus."

#: authentik/brands/models.py
msgid ""
"When set, external users will be redirected to this application after "
"authenticating."
msgstr ""
"Ja iestatīts, ārējie lietotāji pēc pieteikšanās tiks novirzīti uz šo "
"lietotni."

#: authentik/brands/models.py
msgid "Web Certificate used by the authentik Core webserver."
msgstr "Tīmekļa sertifikāts, ko izmanto authentik Core tīmekļa serveris."

#: authentik/brands/models.py
msgid "Certificates used for client authentication."
msgstr "Sertifikāti, ko izmanto klientu autentifikācijai."

#: authentik/brands/models.py
msgid "Brand"
msgstr "Zīmols"

#: authentik/brands/models.py
msgid "Brands"
msgstr "Zīmoli"

#: authentik/brands/models.py
msgid "Brand Client Certificate"
msgstr "Zīmola klienta sertifikāts"

#: authentik/brands/models.py
msgid "Brand Client Certificates"
msgstr "Zīmola klientu sertifikāti"

#: authentik/common/oauth/constants.py
msgid "Based on the Hashed User ID"
msgstr "Pēc lietotāja ID jaucējkoda"

#: authentik/common/oauth/constants.py
msgid "Based on user ID"
msgstr "Pēc lietotāja ID"

#: authentik/common/oauth/constants.py
msgid "Based on user UUID"
msgstr "Pēc lietotāja UUID"

#: authentik/common/oauth/constants.py
msgid "Based on the username"
msgstr "Pēc lietotājvārda"

#: authentik/common/oauth/constants.py
msgid "Based on the User's Email. This is recommended over the UPN method."
msgstr "Pēc lietotāja e-pasta adreses. Ieteicams UPN metodes vietā."

#: authentik/common/oauth/constants.py
msgid ""
"Based on the User's UPN, only works if user has a 'upn' attribute set. Use "
"this method only if you have different UPN and Mail domains."
msgstr ""
"Pēc lietotāja UPN; darbojas tikai tad, ja lietotājam ir iestatīts atribūts "
"'upn'. Izmantojiet šo metodi tikai tad, ja jums ir atšķirīgi UPN un pasta "
"domēni."

#: authentik/common/saml/exceptions.py
msgid "Cannot decode SAML request."
msgstr "Nevar atkodēt SAML pieprasījumu."

#: authentik/common/saml/exceptions.py
msgid "Verification Certificate configured, but request is not signed."
msgstr "Ir iestatīts pārbaudes sertifikāts, bet pieprasījums nav parakstīts."

#: authentik/common/saml/exceptions.py
msgid "Failed to verify signature"
msgstr "Neizdevās pārbaudīt parakstu"

#: authentik/common/saml/parsers/logout_response.py
msgid "Cannot decode SAML response."
msgstr "Nevar atkodēt SAML atbildi."

#: authentik/core/api/application_entitlements.py
msgid "User does not have access to application."
msgstr "Lietotājam nav piekļuves lietotnei."

#: authentik/core/api/application_entitlements.py
msgid ""
"Entitlements assigned to this user, directly or through a group, regardless "
"of the user's access to the application."
msgstr ""
"Tiesības, kas piešķirtas šim lietotājam tieši vai ar grupas starpniecību, "
"neatkarīgi no lietotāja piekļuves lietotnei."

#: authentik/core/api/applications.py
#, python-brace-format
msgid "The slug '{slug}' is reserved and cannot be used for applications."
msgstr "Īsvārds '{slug}' ir rezervēts, un to nevar izmantot lietotnēm."

#: authentik/core/api/groups.py
msgid "User does not have permission to add members to this group."
msgstr "Lietotājam nav atļaujas pievienot dalībniekus šai grupai."

#: authentik/core/api/groups.py authentik/core/api/users.py
msgid "User does not have permission to add members to a superuser group."
msgstr "Lietotājam nav atļaujas pievienot dalībniekus superlietotāju grupai."

#: authentik/core/api/groups.py
msgid "User does not have permission to add a superuser parent group."
msgstr "Lietotājam nav atļaujas pievienot superlietotāju vecākgrupu."

#: authentik/core/api/groups.py authentik/core/api/users.py
msgid "User does not have permission to assign roles."
msgstr "Lietotājam nav atļaujas piešķirt lomas."

#: authentik/core/api/object_attributes.py
msgid "Unique cannot be enabled for arrays."
msgstr "Unikalitāti nevar iespējot masīviem."

#: authentik/core/api/providers.py
msgid ""
"When not set all providers are returned. When set to true, only backchannel "
"providers are returned. When set to false, backchannel providers are "
"excluded"
msgstr ""
"Ja nav iestatīts, tiek atgriezti visi pakalpojumu sniedzēji. Ja iestatīts uz"
" true, tiek atgriezti tikai aizmugures kanāla pakalpojumu sniedzēji. Ja "
"iestatīts uz false, aizmugures kanāla pakalpojumu sniedzēji tiek izslēgti"

#: authentik/core/api/users.py
msgid "No leading or trailing slashes allowed."
msgstr "Sākuma vai beigu slīpsvītras nav atļautas."

#: authentik/core/api/users.py
msgid "No empty segments in user path allowed."
msgstr "Tukši segmenti lietotāja ceļā nav atļauti."

#: authentik/core/api/users.py
msgid "Can't create internal service accounts"
msgstr "Nevar izveidot iekšējos servisa kontus"

#: authentik/core/api/users.py
msgid "Can't change internal service account to other user type."
msgstr "Iekšējo servisa kontu nevar mainīt uz citu lietotāja veidu."

#: authentik/core/api/users.py
msgid "Cannot set both password and password_hash. Use only one."
msgstr ""
"Nevar iestatīt gan password, gan password_hash. Izmantojiet tikai vienu."

#: authentik/core/api/users.py
msgid "Can't modify internal service account users"
msgstr "Iekšējo servisa kontu lietotājus nevar mainīt"

#: authentik/core/api/users.py
msgid "This field is required."
msgstr "Šis lauks ir obligāts."

#: authentik/core/api/users.py
msgid ""
"Import a valid password hash even when its parameters do not match "
"authentik's current password hashing settings."
msgstr ""
"Importēt derīgu paroles jaucējkodu arī tad, ja tā parametri neatbilst "
"authentik pašreizējiem paroļu jaukšanas iestatījumiem."

#: authentik/core/api/users.py
#, python-format
msgid "%(reason)s Set \"override\" to true to import it anyway."
msgstr "%(reason)s Iestatiet \"override\" uz true, lai to tomēr importētu."

#: authentik/core/api/users.py
msgid "No recovery flow set."
msgstr "Atkopšanas plūsma nav iestatīta."

#: authentik/core/api/users.py
msgid "Recovery flow not applicable to user"
msgstr "Atkopšanas plūsma nav piemērojama lietotājam"

#: authentik/core/api/users.py
msgid "A user/group with these details already exists"
msgstr "Lietotājs/grupa ar šādiem datiem jau pastāv"

#: authentik/core/api/users.py
msgid "Unable to create user"
msgstr "Nevar izveidot lietotāju"

#: authentik/core/api/users.py
msgid "Unknown error occurred"
msgstr "Radās nezināma kļūda"

#: authentik/core/api/users.py
msgid "User does not have an email address set."
msgstr "Lietotājam nav iestatīta e-pasta adrese."

#: authentik/core/api/users.py
msgid "Email stage not found."
msgstr "E-pasta posms nav atrasts."

#: authentik/core/apps.py
msgid "Applications with no policies bound can be accessed by any user."
msgstr "Lietotnēm bez piesaistītām politikām var piekļūt jebkurš lietotājs."

#: authentik/core/models.py
msgid "name"
msgstr "nosaukums"

#: authentik/core/models.py
msgid "Users added to this group will be superusers."
msgstr "Šai grupai pievienotie lietotāji būs superlietotāji."

#: authentik/core/models.py
msgid "Group"
msgstr "Grupa"

#: authentik/core/models.py
msgid "Groups"
msgstr "Grupas"

#: authentik/core/models.py
msgid "Add user to group"
msgstr "Pievienot lietotāju grupai"

#: authentik/core/models.py
msgid "Remove user from group"
msgstr "Noņemt lietotāju no grupas"

#: authentik/core/models.py
msgid "Enable superuser status"
msgstr "Iespējot superlietotāja statusu"

#: authentik/core/models.py
msgid "Disable superuser status"
msgstr "Atspējot superlietotāja statusu"

#: authentik/core/models.py
msgid "Group Parentage Node"
msgstr "Grupu hierarhijas mezgls"

#: authentik/core/models.py
msgid "Group Parentage Nodes"
msgstr "Grupu hierarhijas mezgli"

#: authentik/core/models.py
msgid "User's display name."
msgstr "Lietotāja parādāmais vārds."

#: authentik/core/models.py authentik/providers/oauth2/models.py
#: authentik/providers/saml/models.py
msgid "User"
msgstr "Lietotājs"

#: authentik/core/models.py
msgid "Users"
msgstr "Lietotāji"

#: authentik/core/models.py
#: authentik/stages/email/templates/email/password_reset.html
msgid "Reset Password"
msgstr "Atiestatīt paroli"

#: authentik/core/models.py
msgid "Can impersonate other users"
msgstr "Var uzdoties par citiem lietotājiem"

#: authentik/core/models.py
msgid "Can preview user data sent to providers"
msgstr "Var priekšskatīt pakalpojumu sniedzējiem nosūtītos lietotāja datus"

#: authentik/core/models.py
msgid "View applications the user has access to"
msgstr "Skatīt lietotnes, kurām lietotājam ir piekļuve"

#: authentik/core/models.py
msgid ""
"Flow used for authentication when the associated application is accessed by "
"an un-authenticated user."
msgstr ""
"Plūsma, ko izmanto pieteikšanās veikšanai, kad saistītajai lietotnei "
"piekļūst lietotājs, kurš nav pieteicies."

#: authentik/core/models.py
msgid "Flow used when authorizing this provider."
msgstr "Plūsma, ko izmanto, autorizējot šo pakalpojuma sniedzēju."

#: authentik/core/models.py
msgid "Flow used ending the session from a provider."
msgstr "Plūsma, ko izmanto sesijas beigšanai no pakalpojuma sniedzēja."

#: authentik/core/models.py
msgid ""
"Accessed from applications; optional backchannel providers for protocols "
"like LDAP and SCIM."
msgstr ""
"Piekļūst no lietotnēm; neobligāti aizmugures kanāla pakalpojumu sniedzēji "
"tādiem protokoliem kā LDAP un SCIM."

#: authentik/core/models.py
msgid "Application's display Name."
msgstr "Lietotnes parādāmais nosaukums."

#: authentik/core/models.py
msgid "Internal application name, used in URLs."
msgstr "Lietotnes iekšējais nosaukums, ko izmanto URL."

#: authentik/core/models.py
msgid "Open launch URL in a new browser tab or window."
msgstr "Atvērt palaišanas URL jaunā pārlūkprogrammas cilnē vai logā."

#: authentik/core/models.py
msgid "Hide this application from the user's My applications page."
msgstr "Paslēpt šo lietotni lietotāja lapā Manas lietotnes."

#: authentik/core/models.py
msgid "Application"
msgstr "Lietotne"

#: authentik/core/models.py
msgid "Applications"
msgstr "Lietotnes"

#: authentik/core/models.py
msgid "Application Entitlement"
msgstr "Lietotnes tiesības"

#: authentik/core/models.py
msgid "Application Entitlements"
msgstr "Lietotnes tiesības"

#: authentik/core/models.py
msgid "Use the source-specific identifier"
msgstr "Izmantot avotam specifisko identifikatoru"

#: authentik/core/models.py
msgid ""
"Link to a user with identical email address. Can have security implications "
"when a source doesn't validate email addresses."
msgstr ""
"Sasaistīt ar lietotāju, kuram ir identiska e-pasta adrese. Var ietekmēt "
"drošību, ja avots nepārbauda e-pasta adreses."

#: authentik/core/models.py
msgid ""
"Use the user's email address, but deny enrollment when the email address "
"already exists."
msgstr ""
"Izmantot lietotāja e-pasta adresi, bet liegt reģistrēšanos, ja šāda e-pasta "
"adrese jau ir."

#: authentik/core/models.py
msgid ""
"Link to a user with identical username. Can have security implications when "
"a username is used with another source."
msgstr ""
"Sasaistīt ar lietotāju, kuram ir identisks lietotājvārds. Var ietekmēt "
"drošību, ja šo lietotājvārdu izmanto arī cits avots."

#: authentik/core/models.py
msgid ""
"Use the user's username, but deny enrollment when the username already "
"exists."
msgstr ""
"Izmantot lietotāja lietotājvārdu, bet liegt reģistrēšanos, ja šāds "
"lietotājvārds jau ir."

#: authentik/core/models.py
msgid ""
"Link to a group with identical name. Can have security implications when a "
"group name is used with another source."
msgstr ""
"Sasaistīt ar grupu, kurai ir tāds pats nosaukums. Var ietekmēt drošību, ja "
