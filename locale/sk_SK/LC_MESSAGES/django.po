#: authentik/admin/files/api.py
#, python-brace-format
msgid "File size ({file.size}B) exceeds maximum allowed "
msgstr "Veľkosť súboru ({file.size}B) prekračuje maximálnu povolenú "

#: authentik/admin/files/validation.py
msgid "File name cannot be empty"
msgstr "Názov súboru nemôže byť prázdny"

#: authentik/admin/files/validation.py
#, python-format
msgid ""
"File name can only contain letters (a-z, A-Z), numbers (0-9), dots (.), "
"hyphens (-), underscores (_), forward slashes (/), and the placeholder "
"%(theme)s for theme-specific files"
msgstr ""
"Názov súboru môže obsahovať iba písmená (a-z, A-Z), číslice (0-9), bodky "
"(.), pomlčky (-), podčiarkovníky (_), lomky (/), a zástupný symbol %(theme)s"
" pre súbory špecifické pre tému"

#: authentik/admin/files/validation.py
msgid "File name cannot contain duplicate /"
msgstr "Názov súboru nemôže obsahovať duplicitné /"

#: authentik/admin/files/validation.py
msgid "Absolute paths are not allowed"
msgstr "Absolútne cesty nie sú povolené"

#: authentik/admin/files/validation.py
msgid "Parent directory references ('..') are not allowed"
msgstr "Referencie na nadradený adresár ('..') nie sú povolené"

#: authentik/admin/files/validation.py
msgid "Paths cannot start with '.'"
msgstr "Cesty nemôžu začínať '.'"

#: authentik/admin/files/validation.py
#, python-brace-format
msgid "File name too long (max {MAX_FILE_NAME_LENGTH} characters)"
msgstr "Názov súboru je príliš dlhý (max {MAX_FILE_NAME_LENGTH} znakov)"

#: authentik/admin/files/validation.py
#, python-brace-format
msgid "Path component too long (max {MAX_PATH_COMPONENT_LENGTH} characters)"
msgstr "Časť cesty je príliš dlhá (max {MAX_PATH_COMPONENT_LENGTH} znakov)"

