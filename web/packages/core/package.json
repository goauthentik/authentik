{
    "name": "@goauthentik/core",
    "version": "1.0.0",
    "description": "Core functionality for the authentik monorepo",
    "license": "MIT",
    "private": true,
    "scripts": {
        "build": "tsc -p ."
    },
    "main": "./index.ts",
    "type": "module",
    "types": "./index.ts",
    "exports": {
        "./package.json": "./package.json",
        "./*/browser": "./*/browser.ts",
        "./*/node": "./*/node.ts",
        "./*": "./*/index.ts",
        ".": "./index.ts"
    },
    "imports": {
        "#*/browser": "./*/browser.ts",
        "#*/node": "./*/node.ts",
        "#*": "./*/index.ts"
    },
    "dependencies": {
        "@goauthentik/tsconfig": "^2.0.0",
        "@types/node": "catalog:",
        "@types/semver": "^7.7.1",
        "semver": "^7.8.5",
        "typescript": "catalog:"
    },
    "engines": {
        "node": ">=24"
    }
}
