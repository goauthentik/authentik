{
    "name": "@goauthentik/authentik",
    "version": "2026.11.0-rc1",
    "private": true,
    "type": "module",
    "imports": {
        "#logger": {
            "types": "./packages/logger-js/out/lib/node.d.ts",
            "default": "./packages/logger-js/lib/node.ts"
        }
    },
    "scripts": {
        "build:lint-config": "pnpm --filter @goauthentik/oxlint-config --filter @goauthentik/oxfmt-config run build",
        "build:types": "tsc -b",
        "check": "run-s lint:check format:check build:types lint:runtime lint:catalogs lint:spellcheck check:workspaces",
        "check:workspaces": "pnpm -r run check",
        "fix": "run-s lint format fix:workspaces",
        "fix:workspaces": "pnpm -r run fix",
        "format": "oxfmt --write scripts/node *.config.ts *.json *.jsonc",
        "format:check": "oxfmt --check scripts/node *.config.ts *.json *.jsonc",
        "lint": "oxlint --fix scripts/node *.config.ts *.json *.jsonc",
        "lint:catalogs": "node ./scripts/node/lint-catalogs.ts",
        "lint:check": "oxlint --max-warnings=0 scripts/node *.config.ts *.json *.jsonc",
        "lint:runtime": "node ./scripts/node/lint-runtime.ts",
        "lint:spellcheck": "cspell . --config cspell.config.jsonc"
    },
    "dependencies": {
        "@goauthentik/docusaurus-config": "workspace:*",
        "@goauthentik/logger-js": "workspace:*",
        "@goauthentik/oxfmt-config": "workspace:*",
        "@goauthentik/oxlint-config": "workspace:*",
        "@goauthentik/tsconfig": "workspace:*",
        "@types/node": "catalog:",
        "cspell": "^10.3.6",
        "npm-run-all": "^4.1.5",
        "pino": "^10.3.1",
        "pino-pretty": "^13.1.3",
        "typescript": "catalog:",
        "yaml": "^2.9.1"
    },
    "devDependencies": {
        "oxfmt": "catalog:",
        "oxlint": "catalog:"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": ">=24.20",
            "onFail": "error"
        }
    },
    "engines": {
        "node": ">=24",
        "pnpm": ">=12.4.0"
    },
    "packageManager": "pnpm@12.9.1+sha512.06b055fff5cd20dc12781de173ced3310ce0951bf2ec620211a16045d5444d5c93a663210764ef29a653a610459ba0368f0e74f84d80c54723cf95aae7bc0d6d"
}
