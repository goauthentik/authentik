{
    "name": "@goauthentik/authentik",
    "version": "2027.2.0-rc1",
    "private": true,
    "type": "module",
    "imports": {
        "#logger": {
            "types": "./packages/logger-js/out/lib/node.d.ts",
            "default": "./packages/logger-js/lib/node.ts"
        },
        "#dev-mcp/*": "./dev/mcp/lib/*.ts",
        "#dev/*": "./dev/*.ts"
    },
    "scripts": {
        "build:lint-config": "pnpm --filter @goauthentik/oxlint-config --filter @goauthentik/oxfmt-config run build",
        "build:types": "tsc -b",
        "check": "run-s lint:check format:check build:types test:dev-mcp lint:runtime lint:catalogs lint:spellcheck check:workspaces",
        "check:workspaces": "pnpm -r run check",
        "dev-mcp": "node dev/mcp/main.ts",
        "fix": "run-s lint format fix:workspaces",
        "fix:workspaces": "pnpm -r run fix",
        "format": "oxfmt --write scripts/node dev *.config.ts *.json *.jsonc",
        "format:check": "oxfmt --check scripts/node dev *.config.ts *.json *.jsonc",
        "lint": "oxlint --fix scripts/node dev *.config.ts *.json *.jsonc",
        "lint:catalogs": "node ./scripts/node/lint-catalogs.ts",
        "lint:check": "oxlint --max-warnings=0 scripts/node dev *.config.ts *.json *.jsonc",
        "lint:runtime": "node ./scripts/node/lint-runtime.ts",
        "lint:spellcheck": "cspell . --config cspell.config.jsonc --no-progress",
        "test:dev-mcp": "vitest run --config dev/mcp/vite.config.ts"
    },
    "dependencies": {
        "@goauthentik/docusaurus-config": "workspace:*",
        "@goauthentik/logger-js": "workspace:*",
        "@goauthentik/oxfmt-config": "workspace:*",
        "@goauthentik/oxlint-config": "workspace:*",
        "@goauthentik/tsconfig": "workspace:*",
        "@modelcontextprotocol/server": "^2.4.0",
        "@types/node": "catalog:",
        "cspell": "^10.5.2",
        "npm-run-all": "^4.1.5",
        "pg": "^8.23.1",
        "pino": "^10.4.0",
        "pino-pretty": "^13.2.0",
        "typescript": "catalog:",
        "yaml": "^2.9.1",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@modelcontextprotocol/client": "^2.4.0",
        "@types/mdast": "^4.0.4",
        "@types/pg": "^8.23.1",
        "mdast-util-from-markdown": "^2.1.0",
        "mdast-util-mdx": "^3.0.0",
        "mdast-util-to-markdown": "^2.1.2",
        "oxfmt": "catalog:",
        "oxlint": "catalog:",
        "vitest": "catalog:"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": "^24.22.3 || >=26.13.1",
            "onFail": "error"
        }
    },
    "engines": {
        "node": "^24.22.3 || >=26.13.1",
        "pnpm": ">=12.4.0"
    },
    "packageManager": "pnpm@12.23.0+sha512.02da94ffaf133f46074322afe552f90d40b5f71ae259aefbccdacc5085b1d617e98d65e0131f5748b9b67445978ee5055d7d59a473f1eef0d504854fefcd5975"
}
